---
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { researchProjects, researchThemes, withBase } from '../data/site';
---

<BaseLayout title="研究" titleEn="Research" titleZh="研究">
  <PageHero
    className="research-page-hero"
    eyebrowEn="Research"
    eyebrowZh="研究"
    title="灾后恢复、空间治理与韧性未来"
    titleEn="Post-disaster recovery, spatial governance, and resilient futures."
    titleZh="灾后恢复、空间治理与韧性未来"
    textEn="The research agenda treats post-disaster reconstruction as a long-term, uneven process shaped by policy intervention, spatial inequality, ecological adaptation, and community participation."
    textZh="研究议程将灾后重建理解为一个长期且不均衡的过程，关注政策干预、空间不平等、生态适应与公众参与如何共同塑造复原空间。"
  />

  <section class="featured-research-project" aria-labelledby="featured-project-title">
    <div class="research-project-copy">
      <p class="eyebrow" data-lang-en="Featured Research Project" data-lang-zh="重点研究项目">
        重点研究项目
      </p>
      <h2
        id="featured-project-title"
        data-lang-en="Post-disaster monitoring across Wenchuan and the Trans-Himalaya"
        data-lang-zh="汶川与跨喜马拉雅灾后监测"
      >
        汶川与跨喜马拉雅灾后监测
      </h2>
      <p
        data-lang-en="This project connects the Wenchuan earthquake synthetic-control case with a global disaster globe. It treats recovery as a measurable socioeconomic gap and as a wider mountain-system question shaped by earthquakes, landslides, population exposure, reconstruction investment, and environmental change."
        data-lang-zh="该项目将汶川地震合成控制案例与全球灾害地球相连接，把恢复理解为可测量的社会经济差距，也理解为受地震、滑坡、人口暴露、重建投资与环境变化共同影响的山地系统问题。"
      >
        该项目将汶川地震合成控制案例与全球灾害地球相连接，把恢复理解为可测量的社会经济差距，也理解为受地震、滑坡、人口暴露、重建投资与环境变化共同影响的山地系统问题。
      </p>
      <div class="project-thread">
        <span
          data-lang-en="Case evidence: ten extremely affected Wenchuan counties are modeled with SCM."
          data-lang-zh="案例证据：用合成控制方法刻画十个汶川极重灾区县。"
        >
          案例证据：用合成控制方法刻画十个汶川极重灾区县。
        </span>
        <span
          data-lang-en="Regional extension: Nepal, Kashmir, Uttarakhand, and the Himalayan belt frame comparison."
          data-lang-zh="区域拓展：尼泊尔、克什米尔、北阿坎德与喜马拉雅带构成比较框架。"
        >
          区域拓展：尼泊尔、克什米尔、北阿坎德与喜马拉雅带构成比较框架。
        </span>
        <span
          data-lang-en="Public interface: the globe and slide deck turn analytical results into a research story."
          data-lang-zh="公共界面：地球与演示文稿将分析结果转化为可浏览的研究叙事。"
        >
          公共界面：地球与演示文稿将分析结果转化为可浏览的研究叙事。
        </span>
      </div>
      <div class="project-actions" aria-label="Project links">
        <a href={withBase('/slides/')} data-lang-en="Presentation" data-lang-zh="演示文稿">演示文稿</a>
        <a href={withBase('/wenchuan/')} data-lang-en="Wenchuan SCM Atlas" data-lang-zh="汶川合成控制图谱">汶川合成控制图谱</a>
        <a href={withBase('/map/')} data-lang-en="Global Globe" data-lang-zh="全球地球">全球地球</a>
        <a href={withBase('/projects/global-disaster-map/')} data-lang-en="Project Notes" data-lang-zh="项目说明">项目说明</a>
      </div>
    </div>
    <div class="research-project-visual" aria-hidden="true">
      <div class="project-globe-preview">
        <i></i>
        <span class="case-dot sichuan"></span>
        <span class="case-dot nepal"></span>
        <span class="case-dot kashmir"></span>
        <span class="case-ring"></span>
      </div>
      <div class="project-visual-caption">
        <strong data-lang-en="SCM + Globe" data-lang-zh="合成控制 + 地球">合成控制 + 地球</strong>
        <span
          data-lang-en="Wenchuan recovery evidence meets global disaster exposure mapping."
          data-lang-zh="汶川恢复证据与全球灾害暴露制图相结合。"
        >
          汶川恢复证据与全球灾害暴露制图相结合。
        </span>
      </div>
    </div>
  </section>

  <section class="project-list" aria-label="Research project list">
    {
      researchProjects.map((project) => (
        <article>
          <span data-lang-en={project.eyebrow.en} data-lang-zh={project.eyebrow.zh}>
            {project.eyebrow.zh}
          </span>
          <h3 data-lang-en={project.title.en} data-lang-zh={project.title.zh}>{project.title.zh}</h3>
          <p data-lang-en={project.description.en} data-lang-zh={project.description.zh}>
            {project.description.zh}
          </p>
          <a href={withBase(project.href)} data-lang-en="Open project" data-lang-zh="打开项目">
            打开项目
          </a>
        </article>
      ))
    }
  </section>

  <section class="research-list">
    {
      researchThemes.map((theme) => (
        <article>
          <span data-lang-en={theme.eyebrow.en} data-lang-zh={theme.eyebrow.zh}>
            {theme.eyebrow.zh}
          </span>
          <h3 data-lang-en={theme.title.en} data-lang-zh={theme.title.zh}>{theme.title.zh}</h3>
          <p data-lang-en={theme.description.en} data-lang-zh={theme.description.zh}>
            {theme.description.zh}
          </p>
        </article>
      ))
    }
  </section>

  <section class="split-section typology-section">
    <div>
      <p class="eyebrow" data-lang-en="Typology" data-lang-zh="类型学">类型学</p>
      <h2
        data-lang-en="Material recovery and spatial re-formation"
        data-lang-zh="物质恢复与空间复原"
      >
        物质恢复与空间复原
      </h2>
    </div>
    <div class="typology-panel" aria-labelledby="typology-title">
      <div class="typology-panel-header">
        <h3
          id="typology-title"
          data-lang-en="Typology of Post-Disaster Recovery Trajectories"
          data-lang-zh="灾后恢复轨迹类型学"
        >
          灾后恢复轨迹类型学
        </h3>
        <p
          data-lang-en="Recovery outcomes as a function of material reconstruction and relational reassembly across four dimensions of re-inhabitability."
          data-lang-zh="恢复结果取决于物质重建程度与可再栖居四个维度中的关系重组。"
        >
          恢复结果取决于物质重建程度与可再栖居四个维度中的关系重组。
        </p>
      </div>

      <div class="typology-body">
        <aside class="typology-legend" aria-label="Relational dimensions">
          <div>
            <strong data-lang-en="Degree of Relational Reassembly" data-lang-zh="关系重组程度">
              关系重组程度
            </strong>
            <span
              data-lang-en="across four dimensions of re-inhabitability"
              data-lang-zh="跨越可再栖居的四个维度"
            >
              跨越可再栖居的四个维度
            </span>
          </div>
          <ul>
            <li class="legend-social">
              <i></i>
              <span data-lang-en="Social relations" data-lang-zh="社会关系">社会关系</span>
            </li>
            <li class="legend-ecological">
              <i></i>
              <span data-lang-en="Ecological processes" data-lang-zh="生态过程">生态过程</span>
            </li>
            <li class="legend-multispecies">
              <i></i>
              <span data-lang-en="Multispecies co-existence" data-lang-zh="多物种共存">多物种共存</span>
            </li>
            <li class="legend-cultural">
              <i></i>
              <span data-lang-en="Cultural-symbolic continuity" data-lang-zh="文化-象征连续性">
                文化-象征连续性
              </span>
            </li>
          </ul>
        </aside>

        <div class="typology-map">
          <span class="axis-high y-high" data-lang-en="High" data-lang-zh="高">高</span>
          <span class="axis-low y-low" data-lang-en="Low" data-lang-zh="低">低</span>
          <span class="axis-low x-low" data-lang-en="Low" data-lang-zh="低">低</span>
          <span class="axis-high x-high" data-lang-en="High" data-lang-zh="高">高</span>
          <span
            class="x-axis-title"
            data-lang-en="Degree of Material Reconstruction"
            data-lang-zh="物质重建程度"
          >
            物质重建程度
          </span>

          <div class="typology-grid">
            <article class="typology-card relational">
              <span class="typology-icon" aria-hidden="true">RI</span>
              <h4 data-lang-en="Relational Persistence" data-lang-zh="关系性延续">关系性延续</h4>
              <p class="typology-sub" data-lang-en="Low material / High relational" data-lang-zh="低物质 / 高关系">
                低物质 / 高关系
              </p>
              <p
                data-lang-en="Relational continuity is sustained through social ties, ecological practices, multispecies relations, and cultural meanings."
                data-lang-zh="关系连续性通过社会联系、生态实践、多物种关系和文化意义得以维持。"
              >
                关系连续性通过社会联系、生态实践、多物种关系和文化意义得以维持。
              </p>
            </article>

            <article class="typology-card integrated">
              <span class="typology-icon" aria-hidden="true">IN</span>
              <h4 data-lang-en="Integrated Re-inhabitation" data-lang-zh="整合型再栖居">整合型再栖居</h4>
              <p class="typology-sub" data-lang-en="High material / High relational" data-lang-zh="高物质 / 高关系">
                高物质 / 高关系
              </p>
              <p
                data-lang-en="Material reconstruction progresses with the reassembly of social, ecological, multispecies, and cultural-symbolic relations."
                data-lang-zh="物质重建与社会、生态、多物种和文化-象征关系的重组同步推进。"
              >
                物质重建与社会、生态、多物种和文化-象征关系的重组同步推进。
              </p>
            </article>

            <div class="typology-center">
              <strong data-lang-en="Uneven Relational Reassembly" data-lang-zh="不均衡的关系重组">
                不均衡的关系重组
              </strong>
              <span
                data-lang-en="Recovery is not linear or uniform."
                data-lang-zh="恢复并非线性或均质。"
              >
                恢复并非线性或均质。
              </span>
            </div>

            <article class="typology-card collapsed">
              <span class="typology-icon" aria-hidden="true">CR</span>
              <h4 data-lang-en="Collapsed Recovery" data-lang-zh="崩塌型恢复">崩塌型恢复</h4>
              <p class="typology-sub" data-lang-en="Low material / Low relational" data-lang-zh="低物质 / 低关系">
                低物质 / 低关系
              </p>
              <p
                data-lang-en="Material reconstruction and relational reassembly both fail to progress, reinforcing uninhabitable conditions."
                data-lang-zh="物质重建和关系重组都未能推进，并共同强化不可居条件。"
              >
                物质重建和关系重组都未能推进，并共同强化不可居条件。
              </p>
            </article>

            <article class="typology-card disembedded">
              <span class="typology-icon" aria-hidden="true">DR</span>
              <h4 data-lang-en="Disembedded Reconstruction" data-lang-zh="脱嵌式重建">脱嵌式重建</h4>
              <p class="typology-sub" data-lang-en="High material / Low relational" data-lang-zh="高物质 / 低关系">
                高物质 / 低关系
              </p>
              <p
                data-lang-en="Physical reconstruction is achieved, but relational systems remain weak, fragmented, or excluded."
                data-lang-zh="物理重建已经完成，但关系系统仍然薄弱、碎片化或被排除。"
              >
                物理重建已经完成，但关系系统仍然薄弱、碎片化或被排除。
              </p>
            </article>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
