---
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { researchProjects, researchThemes, withBase } from '../data/site';
---

<BaseLayout title="研究" titleEn="Research" titleZh="研究">
  <PageHero
    className="research-page-hero"
    eyebrowEn="Research"
    eyebrowZh="研究"
    title="灾后恢复、空间治理与韧性未来"
    titleEn="Post-disaster recovery, spatial governance, and resilient futures."
    titleZh="灾后恢复、空间治理与韧性未来"
    textEn="The research agenda treats post-disaster reconstruction as a long-term, uneven process shaped by policy intervention, spatial inequality, ecological adaptation, and community participation."
    textZh="研究议程将灾后重建理解为一个长期且不均衡的过程，关注政策干预、空间不平等、生态适应与公众参与如何共同塑造复原空间。"
  />

  <section class="featured-research-project" aria-labelledby="featured-project-title">
    <div class="research-project-copy">
      <p class="eyebrow" data-lang-en="Featured Research Project" data-lang-zh="重点研究项目">
        重点研究项目
      </p>
      <h2
        id="featured-project-title"
        data-lang-en="Post-disaster monitoring across Wenchuan and the Trans-Himalaya"
        data-lang-zh="汶川与跨喜马拉雅灾后监测"
      >
        汶川与跨喜马拉雅灾后监测
      </h2>
      <p
        data-lang-en="This project connects the Wenchuan earthquake synthetic-control case with a global disaster globe. It treats recovery as a measurable socioeconomic gap and as a wider mountain-system question shaped by earthquakes, landslides, population exposure, reconstruction investment, and environmental change."
        data-lang-zh="该项目将汶川地震合成控制案例与全球灾害地球相连接，把恢复理解为可测量的社会经济差距，也理解为受地震、滑坡、人口暴露、重建投资与环境变化共同影响的山地系统问题。"
      >
        该项目将汶川地震合成控制案例与全球灾害地球相连接，把恢复理解为可测量的社会经济差距，也理解为受地震、滑坡、人口暴露、重建投资与环境变化共同影响的山地系统问题。
      </p>
      <div class="project-thread">
        <span
          data-lang-en="Case evidence: ten extremely affected Wenchuan counties are modeled with SCM."
          data-lang-zh="案例证据：用合成控制方法刻画十个汶川极重灾区县。"
        >
          案例证据：用合成控制方法刻画十个汶川极重灾区县。
        </span>
        <span
          data-lang-en="Regional extension: Nepal, Kashmir, Uttarakhand, and the Himalayan belt frame comparison."
          data-lang-zh="区域拓展：尼泊尔、克什米尔、北阿坎德与喜马拉雅带构成比较框架。"
        >
          区域拓展：尼泊尔、克什米尔、北阿坎德与喜马拉雅带构成比较框架。
        </span>
        <span
          data-lang-en="Public interface: the globe and slide deck turn analytical results into a research story."
          data-lang-zh="公共界面：地球与演示文稿将分析结果转化为可浏览的研究叙事。"
        >
          公共界面：地球与演示文稿将分析结果转化为可浏览的研究叙事。
        </span>
      </div>
      <div class="project-actions" aria-label="Project links">
        <a href={withBase('/slides/')} data-lang-en="Presentation" data-lang-zh="演示文稿">演示文稿</a>
        <a href={withBase('/wenchuan/')} data-lang-en="Wenchuan SCM Atlas" data-lang-zh="汶川合成控制图谱">汶川合成控制图谱</a>
        <a href={withBase('/map/')} data-lang-en="Global Globe" data-lang-zh="全球地球">全球地球</a>
        <a href={withBase('/projects/global-disaster-map/')} data-lang-en="Project Notes" data-lang-zh="项目说明">项目说明</a>
      </div>
    </div>
    <div class="research-project-visual" aria-hidden="true">
      <div class="project-globe-preview">
        <i></i>
        <span class="case-dot sichuan"></span>
        <span class="case-dot nepal"></span>
        <span class="case-dot kashmir"></span>
        <span class="case-ring"></span>
      </div>
      <div class="project-visual-caption">
        <strong data-lang-en="SCM + Globe" data-lang-zh="合成控制 + 地球">合成控制 + 地球</strong>
        <span
          data-lang-en="Wenchuan recovery evidence meets global disaster exposure mapping."
          data-lang-zh="汶川恢复证据与全球灾害暴露制图相结合。"
        >
          汶川恢复证据与全球灾害暴露制图相结合。
        </span>
      </div>
    </div>
  </section>

  <section class="project-list" aria-label="Research project list">
    {
      researchProjects.map((project) => (
        <article>
          <span data-lang-en={project.eyebrow.en} data-lang-zh={project.eyebrow.zh}>
            {project.eyebrow.zh}
          </span>
          <h3 data-lang-en={project.title.en} data-lang-zh={project.title.zh}>{project.title.zh}</h3>
          <p data-lang-en={project.description.en} data-lang-zh={project.description.zh}>
            {project.description.zh}
          </p>
          <a href={withBase(project.href)} data-lang-en="Open project" data-lang-zh="打开项目">
            打开项目
          </a>
        </article>
      ))
    }
  </section>

  <section class="research-list">
    {
      researchThemes.map((theme) => (
        <article>
          <span data-lang-en={theme.eyebrow.en} data-lang-zh={theme.eyebrow.zh}>
            {theme.eyebrow.zh}
          </span>
          <h3 data-lang-en={theme.title.en} data-lang-zh={theme.title.zh}>{theme.title.zh}</h3>
          <p data-lang-en={theme.description.en} data-lang-zh={theme.description.zh}>
            {theme.description.zh}
          </p>
        </article>
      ))
    }
  </section>

  <section class="split-section">
    <div>
      <p class="eyebrow" data-lang-en="Typology" data-lang-zh="类型学">类型学</p>
      <h2
        data-lang-en="Material recovery and spatial re-formation"
        data-lang-zh="物质恢复与空间复原"
      >
        物质恢复与空间复原
      </h2>
    </div>
    <figure class="typology-figure">
      <img
        src={withBase('/assets/recovery-typology.svg')}
        alt="Typology of Post-Disaster Recovery Trajectories"
        loading="lazy"
      />
    </figure>
  </section>
</BaseLayout>
