---
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { researchProjects, researchThemes } from '../data/site';
---

<BaseLayout title="Research">
  <PageHero
    eyebrow="Research"
    title="Reconstruction, relation, and inhabitable futures."
    text="The research agenda centers post-disaster reconstruction as a long-term, uneven process of relational reassembly."
    image="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1400&q=80"
  />

  <section class="section-heading">
    <p class="eyebrow">Current Agenda</p>
    <h2>Post-disaster work</h2>
    <p>
      This area draws from the paper "From Recovery to Re-inhabitability" and develops a
      comparative vocabulary for cases where material rebuilding and meaningful dwelling diverge.
    </p>
  </section>

  <section class="featured-research-project" aria-labelledby="featured-project-title">
    <div class="research-project-copy">
      <p class="eyebrow">Featured Research Project</p>
      <h2 id="featured-project-title">Post-disaster monitoring across Wenchuan and the Trans-Himalaya</h2>
      <p>
        This project connects the Wenchuan earthquake synthetic-control case with a global
        disaster globe. It treats recovery as a measurable socioeconomic gap and as a wider
        mountain-system question shaped by earthquakes, landslides, population exposure,
        reconstruction investment, and environmental change.
      </p>
      <div class="project-thread">
        <span><strong>Case evidence</strong> Ten extremely affected Wenchuan counties are modeled with SCM.</span>
        <span><strong>Regional extension</strong> Nepal, Kashmir, Uttarakhand, and the Himalayan belt frame comparison.</span>
        <span><strong>Public interface</strong> The globe and slide deck turn analytical results into a research story.</span>
      </div>
      <div class="project-actions" aria-label="Project links">
        <a href="/slides/">Presentation</a>
        <a href="/wenchuan/">Wenchuan SCM Atlas</a>
        <a href="/map/">Global Globe</a>
        <a href="/projects/global-disaster-map/">Project Notes</a>
      </div>
    </div>
    <div class="research-project-visual" aria-hidden="true">
      <div class="project-globe-preview">
        <i></i>
        <span class="case-dot sichuan"></span>
        <span class="case-dot nepal"></span>
        <span class="case-dot kashmir"></span>
        <span class="case-ring"></span>
      </div>
      <div class="project-visual-caption">
        <strong>SCM + Globe</strong>
        <span>Wenchuan recovery evidence meets global disaster exposure mapping.</span>
      </div>
    </div>
  </section>

  <section class="section-heading">
    <p class="eyebrow">Research Projects</p>
    <h2>Current project interfaces</h2>
    <p>
      These pages translate the research agenda into presentation, mapping, modeling, and
      data-pipeline outputs.
    </p>
  </section>

  <section class="project-list" aria-label="Research project list">
    {
      researchProjects.map((project) => (
        <article>
          <span>{project.eyebrow}</span>
          <h3>{project.title}</h3>
          <p>{project.description}</p>
          <a href={project.href}>Open project</a>
        </article>
      ))
    }
  </section>

  <section class="research-list">
    {
      researchThemes.map((theme) => (
        <article>
          <span>{theme.eyebrow}</span>
          <h3>{theme.title}</h3>
          <p>{theme.description}</p>
        </article>
      ))
    }
  </section>

  <section class="split-section">
    <div>
      <p class="eyebrow">Typology</p>
      <h2>Material recovery and relational re-inhabitation</h2>
    </div>
    <div class="matrix">
      <div>
        <strong>Integrated re-inhabitation</strong>
        <p>High material recovery and strong relational alignment.</p>
      </div>
      <div>
        <strong>Technocratic restoration</strong>
        <p>Visible reconstruction without sufficient social, ecological, or symbolic fit.</p>
      </div>
      <div>
        <strong>Relational persistence</strong>
        <p>Communities sustain dwelling relations despite limited material reconstruction.</p>
      </div>
      <div>
        <strong>Collapsed recovery</strong>
        <p>Material deficits and relational fragmentation reinforce one another.</p>
      </div>
    </div>
  </section>
</BaseLayout>
