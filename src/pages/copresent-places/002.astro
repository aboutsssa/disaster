  springWind: `<svg viewBox="0 0 320 180" role="img" aria-label="春风弧线与轻微飘动的植物轮廓"><path class="motif-wind" d="M28 68 C82 28 130 88 184 50 C224 22 264 38 292 62"/><path class="motif-wind soft" d="M42 116 C94 82 150 128 206 92 C238 72 268 78 292 98"/><path class="motif-wind fine" d="M76 146 C118 126 156 148 194 128"/><path class="motif-stem" d="M102 132 C112 104 116 84 108 54"/><path class="motif-leaf" d="M110 78 C136 72 152 86 158 108 C134 106 118 96 110 78 Z"/><path class="motif-leaf pale" d="M100 102 C76 94 64 104 58 124 C80 126 94 120 100 102 Z"/></svg>`,
  slantRain: `<svg viewBox="0 0 320 180" role="img" aria-label="斜向细雨、水痕与低风速流线"><path class="motif-wind soft" d="M28 62 C82 42 130 70 184 50 C224 36 260 42 292 58"/><path class="motif-rain" d="M72 40 L50 86"/><path class="motif-rain" d="M118 30 L94 82"/><path class="motif-rain" d="M164 42 L140 94"/><path class="motif-rain" d="M214 34 L190 86"/><path class="motif-rain" d="M260 46 L236 98"/><path class="motif-ground" d="M28 136 C78 130 112 146 164 138 C212 130 250 140 292 128"/><path class="motif-water" d="M58 152 C86 142 112 156 140 148"/><path class="motif-water" d="M178 154 C204 144 230 156 260 148"/></svg>`,
  bambooShoot: `<svg viewBox="0 0 320 180" role="img" aria-label="雨痕、潮湿泥土与破土笋尖"><path class="motif-rain" d="M78 30 L64 60"/><path class="motif-rain" d="M132 20 L118 52"/><path class="motif-rain" d="M208 28 L194 58"/><path class="motif-rain" d="M260 18 L246 50"/><path class="motif-soil" d="M24 130 C70 116 116 144 164 126 C214 108 252 124 296 112"/><path class="motif-soil fine" d="M36 150 C86 138 122 156 170 144 C218 132 252 146 286 134"/><path class="motif-shoot" d="M150 130 C156 88 172 58 192 36 C202 72 202 106 188 132 Z"/><path class="motif-shoot-line" d="M166 112 C178 100 184 86 188 64"/><path class="motif-shoot small" d="M112 136 C116 108 128 88 142 74 C150 102 148 122 138 140 Z"/></svg>`,
  bananaRain: `<svg viewBox="0 0 320 180" role="img" aria-label="芭蕉叶、落雨、水珠与窗格"><path class="motif-window" d="M34 36 H124 V142 H34 Z M79 36 V142 M34 88 H124"/><path class="motif-banana-leaf" d="M176 128 C150 86 160 48 210 24 C240 62 238 104 176 128 Z"/><path class="motif-banana-leaf pale" d="M226 136 C206 98 220 66 268 46 C292 84 278 118 226 136 Z"/><path class="motif-leaf-vein" d="M178 124 C198 92 208 58 210 28"/><path class="motif-leaf-vein fine" d="M228 132 C244 104 258 76 268 48"/><path class="motif-rain" d="M154 34 L142 72"/><path class="motif-rain" d="M190 42 L176 88"/><path class="motif-rain" d="M244 36 L230 82"/><circle class="motif-drop" cx="186" cy="102" r="3"/><circle class="motif-drop" cx="236" cy="114" r="2.8"/><path class="motif-wave soft" d="M144 146 C178 132 214 150 252 136"/></svg>`,
  riceFrog: `<svg viewBox="0 0 320 180" role="img" aria-label="水田、稻穗、蛙影与夜色声波"><path class="motif-water" d="M28 136 C78 126 118 146 166 134 C218 122 256 138 292 126"/><path class="motif-water thin" d="M40 154 C86 144 122 160 174 150 C222 140 252 152 286 144"/><path class="motif-rice" d="M88 132 L88 62 M78 76 L88 90 M98 76 L88 90 M76 102 L88 114 M100 102 L88 114"/><path class="motif-rice" d="M126 136 L126 56 M114 72 L126 88 M140 72 L126 88 M112 102 L126 118 M142 102 L126 118"/><path class="motif-frog" d="M206 130 C190 116 194 94 216 90 C238 96 242 118 226 132 C220 138 212 138 206 130 Z"/><circle class="motif-star" cx="226" cy="104" r="2"/><path class="motif-wave" d="M172 58 C198 42 226 42 252 58"/><path class="motif-wave soft" d="M182 76 C202 66 226 66 246 76"/><circle class="motif-moon" cx="266" cy="42" r="16"/></svg>`,
  fieldPaths: `<svg viewBox="0 0 320 180" role="img" aria-label="田埂、地块边界与步行尺度路径"><path class="motif-field" d="M38 42 H284 V142 H38 Z"/><path class="motif-path" d="M96 42 C86 72 92 112 78 142"/><path class="motif-path" d="M170 42 C178 76 158 104 164 142"/><path class="motif-path" d="M236 42 C222 78 240 110 222 142"/><path class="motif-path" d="M38 82 C90 72 140 92 190 80 C230 70 260 80 284 70"/><path class="motif-path" d="M38 118 C86 110 128 128 174 116 C220 102 250 114 284 106"/><path class="motif-footstep" d="M120 104 C112 108 108 116 112 122 C122 122 128 116 126 108"/><path class="motif-footstep" d="M142 92 C134 96 130 104 134 110 C144 110 150 104 148 96"/></svg>`,
  villageSounds: `<svg viewBox="0 0 320 180" role="img" aria-label="低矮屋舍、鸡犬声波与相邻院落"><path class="motif-house" d="M46 136 V94 L84 64 L122 94 V136 Z"/><path class="motif-house" d="M198 138 V98 L238 70 L278 98 V138 Z"/><path class="motif-ground" d="M34 140 H288"/><path class="motif-wave" d="M126 76 C148 60 172 60 194 76"/><path class="motif-wave soft" d="M136 96 C154 86 170 86 188 96"/><path class="motif-dog" d="M82 132 C90 118 108 118 116 132 L110 132 L106 124 L96 124 L92 132 Z"/><path class="motif-rooster" d="M232 132 C224 116 232 102 248 104 C260 110 258 126 246 132 Z"/><circle class="motif-star" cx="250" cy="104" r="2.5"/></svg>`,
  cookingSmoke: `<svg viewBox="0 0 320 180" role="img" aria-label="低矮屋顶、暮色树线与上升炊烟"><path class="motif-tree-line" d="M28 126 C54 112 76 130 104 116 C130 104 154 122 182 110 C218 94 248 118 292 102"/><path class="motif-roof" d="M58 138 L98 104 L138 138 Z"/><path class="motif-roof" d="M150 140 L190 110 L234 140 Z"/><path class="motif-ground" d="M40 142 H278"/><path class="motif-smoke" d="M104 98 C88 78 116 66 104 46 C94 30 118 22 112 10"/><path class="motif-smoke soft" d="M200 104 C184 82 210 72 198 54 C190 42 206 34 204 22"/><path class="motif-sunset" d="M44 58 C92 42 140 52 188 42 C230 34 266 42 292 54"/></svg>`,
  moonStars: `<svg viewBox="0 0 320 180" role="img" aria-label="月亮、稀疏星点、深色天幕与城市光晕"><rect class="motif-night" x="24" y="24" width="272" height="116" rx="2"/><circle class="motif-moon" cx="92" cy="62" r="20"/><circle class="motif-star" cx="156" cy="48" r="2.5"/><circle class="motif-star" cx="212" cy="72" r="2"/><circle class="motif-star" cx="250" cy="42" r="1.8"/><circle class="motif-star pale" cx="184" cy="96" r="1.6"/><path class="motif-cityglow" d="M36 142 C86 126 132 138 176 128 C222 118 260 128 292 116"/><path class="motif-buildings" d="M198 138 V112 H214 V138 M222 138 V104 H240 V138 M250 138 V118 H264 V138"/></svg>`,
  fireflySnow: `<svg viewBox="0 0 320 180" role="img" aria-label="萤火、雪光、书页和低照度夜读"><rect class="motif-night" x="30" y="26" width="260" height="116" rx="2"/><path class="motif-book" d="M92 126 C116 116 140 116 160 130 C180 116 204 116 228 126 V146 C204 136 180 136 160 150 C140 136 116 136 92 146 Z"/><path class="motif-snow" d="M42 142 C86 126 124 144 168 132 C216 120 250 136 284 124"/><circle class="motif-firefly" cx="102" cy="64" r="4"/><circle class="motif-firefly pale" cx="138" cy="46" r="3"/><circle class="motif-firefly" cx="220" cy="70" r="3.5"/><path class="motif-glow" d="M92 64 C102 54 112 54 122 64 M210 70 C220 60 232 60 242 70"/></svg>`
};
---

<BaseLayout
  title={pageTitleZh}
  titleEn={pageTitleEn}
  titleZh={pageTitleZh}
  descriptionEn={descriptionEn}
  descriptionZh={descriptionZh}
  keywordsEn={keywordsEn.join(', ')}
  keywordsZh={keywordsZh.join(', ')}
  canonicalPath="/copresent-places/002/"
  ogType="article"
>
  <article class="lexical-page">
    <section class="lexical-hero">
      <p class="eyebrow" data-lang-en="Copresent Places 002" data-lang-zh="共时之地 002">共时之地 002</p>
      <div class="lexical-hero-grid">
        <div class="lexical-hero-copy">
          <p
            class="lexical-section-label"
            data-lang-en="Copresent Places"
            data-lang-zh="共时之地 / Copresent Places"
          >
            共时之地 / Copresent Places
          </p>
          <h1 data-lang-en={pageTitleEn} data-lang-zh={pageTitleZh}>{pageTitleZh}</h1>
          <p class="lexical-subtitle" data-lang-en={summaryEn} data-lang-zh={summaryZh}>{summaryZh}</p>
          <div class="lexical-tags" aria-label="Keywords">
            {
              keywordsZh.map((keyword, index) => (
                <span data-lang-en={keywordsEn[index]} data-lang-zh={keyword}>{keyword}</span>
              ))
            }
          </div>
          <div class="lexical-actions">
            <a href="#mechanism" data-lang-en="View mechanism" data-lang-zh="查看机制图">查看机制图</a>
            <a href="#lexicon" data-lang-en="Enter scene lexicon" data-lang-zh="进入场景词标本室">
              进入场景词标本室
            </a>
            <a href="#contribute" data-lang-en="Submit a word" data-lang-zh="提交词语">提交词语</a>
          </div>
          <ShareMenu
            titleZh={pageTitleZh}
            titleEn={pageTitleEn}
            descriptionZh={descriptionZh}
            descriptionEn={descriptionEn}
            path="/copresent-places/002/"
          />
        </div>
      </div>
      <p class="lexical-opening" data-lang-en={openingTextEn} data-lang-zh={openingTextZh}>{openingTextZh}</p>
    </section>

    <section class="lexical-section mechanism-section" id="mechanism">
      <div class="lexical-section-heading">
        <p class="eyebrow" data-lang-en="Mechanism" data-lang-zh="机制图">机制图</p>
        <h2 data-lang-en="From Embodied Experience to Hollowed Vocabulary" data-lang-zh="从身体经验到词汇空心化">
          从身体经验到词汇空心化
        </h2>
        <p data-lang-en={mechanismIntroEn} data-lang-zh={mechanismIntroZh}>{mechanismIntroZh}</p>
      </div>

      <!-- Mechanism timeline: a vertical narrative path of how experience is gradually abstracted. -->
      <div class="mechanism-timeline" aria-label="城市化与词汇空心化叙事时间线">
        <span class="mechanism-axis" aria-hidden="true">
          <span class="mechanism-axis-progress"></span>
        </span>
        {
          mechanismItems.map((item) => (
            <article class="mechanism-node" data-timeline-node>
              <div class="mechanism-marker">
                <span>{item.id}</span>
              </div>
              <div class="mechanism-copy">
                <span class="mechanism-tag">{item.tag}</span>
                <h3 data-lang-en={item.titleEn} data-lang-zh={item.titleZh}>{item.titleZh}</h3>
                <div class="mechanism-lens">
                  <span data-lang-en="Theoretical lens" data-lang-zh="理论视角">理论视角</span>
                  <div>
                    {
                      item.theoryTermsZh.map((term, termIndex) => (
                        <span data-lang-en={item.theoryTermsEn[termIndex]} data-lang-zh={term}>{term}</span>
                      ))
                    }
                  </div>
                </div>
                <p class="mechanism-body">
                  <span data-lang-en={item.textEn} data-lang-zh={item.textZh}>{item.textZh}</span>
                  <span class="mechanism-citations" aria-label="citations">
                    {
                      item.citationIds.map((citationId) => (
                        <a href={`#ref-${citationId}`} aria-label={`Reference ${citationId}`}>[{citationId}]</a>
                      ))
                    }
                  </span>
                </p>
                <p
                  class="mechanism-transition"
                  data-lang-en={item.transitionEn}
                  data-lang-zh={item.transitionZh}
                >
                  {item.transitionZh}
                </p>
              </div>
            </article>
          ))
        }
      </div>

      <aside class="theory-references" aria-label="Selected References">
        <section class="selected-references" aria-labelledby="selected-references-title">
          <div class="references-head">
            <h3
              id="selected-references-title"
              data-lang-en="Selected References"
              data-lang-zh="核心理论文献"
            >
              核心理论文献
            </h3>
          </div>
          <ol class="reference-list">
            {
              theoryReferences.map((reference) => (
                <li id={`ref-${reference.id}`}>
                  <a class="reference-number" href={`#ref-${reference.id}`} aria-label={`Reference ${reference.id}`}>
                    [{reference.id}]
                  </a>
                  <span>{reference.text}</span>
                </li>
              ))
            }
          </ol>
        </section>
      </aside>
    </section>

    <section class="lexical-section lexicon-section" id="lexicon">
      <div class="lexical-section-heading">
        <p class="eyebrow" data-lang-en="Lexicon Cabinet" data-lang-zh="词语图谱">
          词语图谱
        </p>
        <h2 data-lang-en="Situated Scene Word Cabinet" data-lang-zh="置身场景词标本室">
          置身场景词标本室
        </h2>
        <p data-lang-en={lexiconIntroEn} data-lang-zh={lexiconIntroZh}>{lexiconIntroZh}</p>
      </div>

      <div class="lexicon-toolbar" aria-label="词汇分类筛选">
        <button
          type="button"
          class="lexicon-filter-button is-active"
          data-category="all"
          data-lang-en="All"
          data-lang-zh="全部"
        >
          全部
        </button>
        {
          categories.map((category) => (
            <button
              type="button"
              class="lexicon-filter-button"
              data-category={category.zh}
              data-lang-en={category.en}
              data-lang-zh={category.zh}
            >
              {category.zh}
            </button>
          ))
        }
      </div>

      <div class="lexicon-grid" aria-live="polite">
        {
          lexiconEntries.map((entry) => (
            <article
              class="lexicon-card"
              data-category={entry.categoryZh}
              data-motif={entry.motif}
              tabindex="0"
              role="button"
              aria-expanded="false"
              aria-label={`${entry.wordZh} 词汇标本`}
            >
              <div class="lexicon-card-topline">
                <span>{entry.id}</span>
                <span data-lang-en={entry.categoryEn} data-lang-zh={entry.categoryZh}>{entry.categoryZh}</span>
              </div>
              <div class="lexicon-card-body">
                <div class="lexicon-word-block">
                  <h3 data-lang-en={entry.wordEn} data-lang-zh={entry.wordZh}>{entry.wordZh}</h3>
                  {
                    entry.subtitleZh && (
                      <p
                        class="lexicon-subtitle"
                        data-lang-en={entry.subtitleEn}
                        data-lang-zh={entry.subtitleZh}
                      >
                        {entry.subtitleZh}
                      </p>
                    )
                  }
                  <p data-lang-en={entry.glimpseEn} data-lang-zh={entry.glimpseZh}>{entry.glimpseZh}</p>
                </div>
                <div
                  class="lexicon-motif"
                  aria-label={entry.motifZh}
                  set:html={motifSvgs[entry.motif]}
                />
              </div>
              <div class="lexicon-detail">
                <dl>
                  <div>
                    <dt data-lang-en="Original Place Experience" data-lang-zh="原初地方经验">原初地方经验</dt>
                    <dd data-lang-en={entry.originalExperienceEn} data-lang-zh={entry.originalExperienceZh}>
                      {entry.originalExperienceZh}
                    </dd>
                  </div>
                  <div>
                    <dt data-lang-en="Modernized Drift" data-lang-zh="现代化后的漂移">现代化后的漂移</dt>
                    <dd data-lang-en={entry.urbanDriftEn} data-lang-zh={entry.urbanDriftZh}>{entry.urbanDriftZh}</dd>
                  </div>
                  <div>
                    <dt data-lang-en="Geographic Diagnosis" data-lang-zh="地理学诊断">地理学诊断</dt>
                    <dd
                      data-lang-en={entry.geographicDiagnosisEn}
                      data-lang-zh={entry.geographicDiagnosisZh}
                    >
                      {entry.geographicDiagnosisZh}
                    </dd>
                  </div>
                </dl>
              </div>
              <div class="sense-tags" aria-label={`${entry.wordZh} 感官标签`}>
                {
                  entry.sensesZh.map((sense, senseIndex) => (
                    <span data-lang-en={entry.sensesEn[senseIndex]} data-lang-zh={sense}>{sense}</span>
                  ))
                }
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="lexical-section contribute-section" id="contribute">
      <div class="contribute-grid">
        <div class="contribute-copy">
          <p class="eyebrow" data-lang-en="Collaborative Cabinet" data-lang-zh="共建标本室">共建标本室</p>
          <h2 data-lang-en="Contribute a Scene Word" data-lang-zh="共建标本室">共建标本室</h2>
          <p
            data-lang-en="If you remember a word, idiom, dialect expression, or line of poetry that is losing its sense of situated experience, you are welcome to leave it with the scene it evokes. We will review submissions manually and may add suitable entries to the cabinet; where possible, we will also continue drawing situated motifs so more readers can re-sense these thinning experiences."
            data-lang-zh="如果你也想起一个正在失去置身感的词语、成语、方言或诗句，欢迎留下它和你记忆中的场景。我们会人工整理，并选择适合的词条加入标本室；如果可能，也会继续为它绘制意向场景，让更多人重新感知这些正在变薄的经验。"
          >
            如果你也想起一个正在失去置身感的词语、成语、方言或诗句，欢迎留下它和你记忆中的场景。我们会人工整理，并选择适合的词条加入标本室；如果可能，也会继续为它绘制意向场景，让更多人重新感知这些正在变薄的经验。
          </p>

          <div class="contribute-criteria">
            <h3 data-lang-en="What are we looking for?" data-lang-zh="我们正在寻找什么？">我们正在寻找什么？</h3>
            <ul>
              <li
                data-lang-en="Words that let a reader enter a concrete scene."
                data-lang-zh="能让人进入一个具体场景的词语"
              >
                能让人进入一个具体场景的词语
              </li>
              <li
                data-lang-en="Expressions carrying sound, smell, touch, light, weather, or place memory."
                data-lang-zh="带有声音、气味、触感、光线、天气或地方记忆的表达"
              >
                带有声音、气味、触感、光线、天气或地方记忆的表达
              </li>
              <li
                data-lang-en="Words still understood in urban life but increasingly hard to experience firsthand."
                data-lang-zh="在现代城市生活中仍被理解、却越来越难被亲身经验的词语"
              >
                在现代城市生活中仍被理解、却越来越难被亲身经验的词语
              </li>
            </ul>
          </div>

          <p
            class="contribute-note"
            data-lang-en="Submissions are not published automatically. We prioritize words with scene, place, and sensory thickness, and may draw situated motifs for future versions."
            data-lang-zh="提交内容不会自动发布。我们会优先选择具有场景感、地方性和感官厚度的词条，并在后续版本中尝试绘制意向场景。"
          >
            提交内容不会自动发布。我们会优先选择具有场景感、地方性和感官厚度的词条，并在后续版本中尝试绘制意向场景。
          </p>

          {
            !contributionFormEndpoint && !hasContributionEmail && (
              <p
                class="contribute-config-note"
                data-lang-en="Submission email is not configured yet. Set PUBLIC_CONTRIBUTION_EMAIL or PUBLIC_CONTRIBUTION_FORM_ENDPOINT before publishing this form."
                data-lang-zh="投稿邮箱尚未配置。发布前请设置 PUBLIC_CONTRIBUTION_EMAIL 或 PUBLIC_CONTRIBUTION_FORM_ENDPOINT。"
              >
                投稿邮箱尚未配置。发布前请设置 PUBLIC_CONTRIBUTION_EMAIL 或 PUBLIC_CONTRIBUTION_FORM_ENDPOINT。
              </p>
            )
          }
        </div>

        <form
          class="contribution-form"
          data-contribution-form
          data-endpoint={contributionFormEndpoint}
          data-email={contributionEmail}
          data-has-email={String(hasContributionEmail)}
          novalidate
        >
          <input
            class="form-honeypot"
            type="text"
            name="website"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />

          <div class="form-heading">
            <h3 data-lang-en="Submit a Scene Word" data-lang-zh="提交一个词语 / Submit a Scene Word">
              提交一个词语 / Submit a Scene Word
            </h3>
            <p
              data-lang-en="No registration is needed. You may leave only the word and a scene memory; name and contact are optional. Submissions are reviewed manually before any public use."
              data-lang-zh="无需注册。你可以只留下词语和场景记忆；署名和联系方式均为可选。提交内容不会自动公开，我们会人工整理后再决定是否收入标本室。"
            >
              无需注册。你可以只留下词语和场景记忆；署名和联系方式均为可选。提交内容不会自动公开，我们会人工整理后再决定是否收入标本室。
            </p>
