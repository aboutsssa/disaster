import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareMenu from '../../components/ShareMenu.astro';

const pageTitleZh = '词汇的失地：城市化如何让词语失去地方、身体与生态参照物';
const pageTitleEn =
  'Displaced Vocabulary: How Urbanization Detaches Words from Place, Body, and Ecological Referents';
const summaryZh = '城市化并不只改变土地使用，也改变语言与身体之间的距离。';
const summaryEn =
  'Urbanization changes not only land use, but also the distance between language and the body.';
const descriptionZh =
  '城市化并不只改变土地使用，也改变语言与身体之间的距离。本文收集正在失去置身感的场景词，并邀请读者共同补充那些仍被理解、却越来越难被亲身经验的词语。';
const descriptionEn =
  'Urbanization changes not only land use, but also the distance between language and the body. This essay collects scene words losing situatedness and invites readers to contribute words that remain intelligible but increasingly difficult to experience firsthand.';
const keywordsZh = ['语言地理', '经验消亡', '地方记忆', '无地方性', '文化景观', '城市化'];
const keywordsEn = [
  'linguistic geography',
  'experiential extinction',
  'place memory',
  'placelessness',
  'cultural landscape',
  'urbanization'
];

const openingTextZh =
  '人类语言作为一种动态的社会规约系统，其词汇库的沉淀与演变本质上是特定历史时期人类生存方式的忠实映射。在漫长的农耕文明中，中华民族以高度发达的生态适应和农业实践，锻造出了一个极其丰富且具有深厚“具身性”的语言体系。在这个体系中，大量的成语、词汇以及修辞意境，如“鸟语花香”“如沐春风”等，直接依托于生动的物理世界和感官体验。然而，随着全球规模最大的城市化进程在中国的高速推进，社会空间、劳作方式和生存环境发生了根本性重塑。';
const openingTextEn =
  'Human language is a dynamic system of social convention, and the sedimentation of its vocabulary faithfully records the ways people lived in particular historical periods. Across a long agrarian civilization, ecological adaptation and agricultural practice produced a richly embodied linguistic system. Many idioms, words, and rhetorical images, such as 鸟语花香 (niao yu hua xiang) and 如沐春风 (ru mu chun feng), rely directly on a vivid physical world and sensory experience. Yet as China has undergone the largest and fastest urbanization process in the world, social space, labor, and everyday environments have been fundamentally remade.';
const mechanismIntroZh =
  '词语并不是凭空漂浮的符号。它们依靠身体、地方、物种、天气、劳动和代际记忆来维持意义。以下五个机制并非单纯的线性流程，而是城市化、空间生产、经验消亡、具身认知和符号拟像共同作用的结果。';
const mechanismIntroEn =
  'Words are not free-floating signs. They rely on bodies, places, species, weather, labor, and intergenerational memory to sustain meaning. The five mechanisms below are not merely a linear process, but the combined result of urbanization, spatial production, extinction of experience, embodied cognition, and symbolic simulation.';
const lexiconIntroZh =
  '以下词语并不是简单地“消失”，而是它们所依托的场景正在从日常生活中退场。人们仍然认识这些词，却越来越少能通过身体、感官和地方经验进入它们。';
const lexiconIntroEn =
  'The words below do not simply disappear. The scenes they depend on are receding from everyday life. People still recognize these words, yet increasingly struggle to enter them through body, senses, and place-based experience.';
const contributionFormEndpoint = import.meta.env.PUBLIC_CONTRIBUTION_FORM_ENDPOINT ?? '';
const contributionEmail = import.meta.env.PUBLIC_CONTRIBUTION_EMAIL ?? 'aboutsssa@gmail.com';
const hasContributionEmail = Boolean(contributionEmail);
