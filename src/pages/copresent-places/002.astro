      }

      .theory-references {
        margin-left: 0;
      }

      .reference-list {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 620px) {
      .lexical-hero h1 {
        max-width: 22ch;
        font-size: clamp(2rem, 9vw, 2.8rem);
      }

      .lexical-actions a {
        width: 100%;
        text-align: center;
      }

      .lexicon-filter-button {
        max-width: 100%;
        overflow-wrap: anywhere;
      }

      .lexicon-grid,
      .checkbox-grid {
        grid-template-columns: 1fr;
      }

      .mechanism-timeline {
        gap: 2.2rem;
        padding-left: 2.9rem;
      }

      .mechanism-axis {
        left: 0.88rem;
      }

      .mechanism-node {
        grid-template-columns: 2.25rem minmax(0, 1fr);
        gap: 0.82rem;
      }

      .mechanism-marker {
        width: 2.25rem;
      }

      .mechanism-marker span {
        font-size: 1rem;
      }

      .lexicon-card {
        min-height: 0;
      }

      .lexicon-motif,
      .lexicon-motif :global(svg) {
        min-height: 160px;
      }
    }
  </style>

  <script>
    const timeline = document.querySelector<HTMLElement>('.mechanism-timeline');
    const timelineNodes = Array.from(document.querySelectorAll<HTMLElement>('[data-timeline-node]'));
    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.lexicon-filter-button'));
    const lexiconCards = Array.from(document.querySelectorAll<HTMLElement>('.lexicon-card'));
    const filterTimers = new WeakMap<HTMLElement, number>();
    const contributionForm = document.querySelector<HTMLFormElement>('[data-contribution-form]');
    const contributionStatus = contributionForm?.querySelector<HTMLElement>('[data-form-status]');
    const mailtoFallback = contributionForm?.querySelector<HTMLAnchorElement>('[data-mailto-fallback]');
    const placeholderFields = Array.from(
      document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-placeholder-en][data-placeholder-zh]')
    );

    const getCurrentLanguage = () => (document.documentElement.dataset.language === 'en' ? 'en' : 'zh');

    const setContributionStatus = (type: 'success' | 'error' | 'neutral', zh: string, en: string) => {
      if (!contributionStatus) return;
      contributionStatus.dataset.langZh = zh;
      contributionStatus.dataset.langEn = en;
      contributionStatus.textContent = getCurrentLanguage() === 'en' ? en : zh;
      contributionStatus.classList.toggle('is-success', type === 'success');
      contributionStatus.classList.toggle('is-error', type === 'error');
    };

    const syncContributionPlaceholders = () => {
      const language = getCurrentLanguage();
      placeholderFields.forEach((field) => {
        field.placeholder = language === 'en' ? field.dataset.placeholderEn || '' : field.dataset.placeholderZh || '';
      });
    };

    const buildContributionPayload = (form: HTMLFormElement) => {
      const formData = new FormData(form);
      return {
        word: String(formData.get('word') || '').trim(),
        scene: String(formData.get('scene') || '').trim(),
        place: String(formData.get('place') || '').trim(),
        senses: formData.getAll('senses').map(String),
        visual_idea: String(formData.get('visual_idea') || '').trim(),
        image_link: String(formData.get('image_link') || '').trim(),
        contributor_name: String(formData.get('contributor_name') || '').trim(),
        contributor_email: String(formData.get('contributor_email') || '').trim(),
        attribution: String(formData.get('attribution') || '').trim(),
        consent: formData.get('consent') === 'on',
        source: '/copresent-places/002/',
        submitted_at: new Date().toISOString()
      };
    };

    const buildMailtoLink = (payload: ReturnType<typeof buildContributionPayload>, email: string) => {
      const subject = `共建标本室投稿：${payload.word}`;
      const body = [
        `推荐词语：${payload.word}`,
        `场景记忆：${payload.scene}`,
        `相关地方或经验：${payload.place || '未填写'}`,
        `感官标签：${payload.senses.length ? payload.senses.join('、') : '未选择'}`,
        `意向场景：${payload.visual_idea || '未填写'}`,
        `图片或素材链接：${payload.image_link || '未填写'}`,
        `称呼：${payload.contributor_name || '匿名'}`,
        `联系邮箱：${payload.contributor_email || '未填写'}`,
        `署名偏好：${payload.attribution || '未选择'}`,
        `来源页面：${payload.source}`
      ].join('\n\n');

      return `mailto:${encodeURIComponent(email)}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    };

    const setTimelineProgress = () => {
      if (!timeline) return;
      const rect = timeline.getBoundingClientRect();
      const viewportMarker = window.innerHeight * 0.58;
      const rawProgress = (viewportMarker - rect.top) / Math.max(rect.height, 1);
      const progress = Math.min(1, Math.max(0, rawProgress));
      timeline.style.setProperty('--timeline-progress', `${progress * 100}%`);
    };

    const timelineObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        entry.target.classList.toggle('is-visible', entry.isIntersecting);
        entry.target.classList.toggle('is-active', entry.isIntersecting && entry.intersectionRatio > 0.45);
      });
    }, { rootMargin: '-18% 0px -34% 0px', threshold: [0.16, 0.45, 0.7] });

    timelineNodes.forEach((node) => timelineObserver.observe(node));
    setTimelineProgress();
    window.addEventListener('scroll', setTimelineProgress, { passive: true });
    window.addEventListener('resize', setTimelineProgress);

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const category = button.dataset.category || 'all';
        filterButtons.forEach((item) => item.classList.toggle('is-active', item === button));
        lexiconCards.forEach((card) => {
          const isHidden = category !== 'all' && card.dataset.category !== category;
          card.setAttribute('aria-hidden', String(isHidden));
          const existingTimer = filterTimers.get(card);
          if (existingTimer) window.clearTimeout(existingTimer);

          if (isHidden) {
            card.classList.remove('is-expanded');
            card.setAttribute('aria-expanded', 'false');
            card.classList.add('is-hiding');
            const timer = window.setTimeout(() => {
              card.hidden = true;
            }, 190);
            filterTimers.set(card, timer);
          } else {
            card.hidden = false;
            requestAnimationFrame(() => {
              card.classList.remove('is-hiding');
            });
          }
        });
      });
    });

    lexiconCards.forEach((card) => {
      card.addEventListener('click', () => {
        if (card.hidden || card.classList.contains('is-hiding')) return;
        card.classList.toggle('is-expanded');
        card.setAttribute('aria-expanded', String(card.classList.contains('is-expanded')));
      });

      card.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        card.click();
      });
    });

    syncContributionPlaceholders();
    window.addEventListener('respace-language-change', syncContributionPlaceholders);

    if (contributionForm) {
      contributionForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (String(new FormData(contributionForm).get('website') || '').trim()) return;

        if (!contributionForm.reportValidity()) {
          setContributionStatus(
            'error',
            '请先补全必填项，并检查邮箱或链接格式。',
            'Please complete required fields and check the email or URL format.'
          );
          return;
        }

        const payload = buildContributionPayload(contributionForm);
        const endpoint = contributionForm.dataset.endpoint || '';
        const email = contributionForm.dataset.email || '';
        const hasEmail = contributionForm.dataset.hasEmail === 'true';

        try {
          if (endpoint) {
            const response = await fetch(endpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });

            if (!response.ok) throw new Error(`Contribution endpoint failed: ${response.status}`);

            contributionForm.reset();
            syncContributionPlaceholders();
            mailtoFallback?.setAttribute('hidden', '');
            setContributionStatus(
              'success',
              '谢谢你的词语。它不会自动公开，我们会在整理后考虑是否收入标本室。',
              'Thank you for the word. It will not be published automatically; we will review it before considering it for the cabinet.'
            );
            return;
          }

          if (!hasEmail || !email || email.includes('TODO-CONFIGURE')) {
            mailtoFallback?.setAttribute('hidden', '');
            setContributionStatus(
              'error',
              '投稿邮箱尚未配置。请先在环境变量中设置 PUBLIC_CONTRIBUTION_EMAIL。',
              'The contribution email is not configured yet. Please set PUBLIC_CONTRIBUTION_EMAIL first.'
            );
            return;
          }

          const mailtoLink = buildMailtoLink(payload, email);
          if (mailtoFallback) {
            mailtoFallback.href = mailtoLink;
            mailtoFallback.removeAttribute('hidden');
          }
          window.location.href = mailtoLink;
          setContributionStatus(
            'success',
            '谢谢你的词语。它不会自动公开，我们会在整理后考虑是否收入标本室。',
            'Thank you for the word. It will not be published automatically; we will review it before considering it for the cabinet.'
          );
        } catch (error) {
          if (hasEmail && email && !email.includes('TODO-CONFIGURE')) {
            const fallbackLink = buildMailtoLink(payload, email);
            if (mailtoFallback) {
              mailtoFallback.href = fallbackLink;
              mailtoFallback.removeAttribute('hidden');
            }
          }
          setContributionStatus(
            'error',
            '提交暂时没有成功。你可以复制内容后通过邮箱发送给我们。',
            'Submission did not succeed. You can copy the content and send it to us by email.'
          );
        }
      });
    }
  </script>
</BaseLayout>
