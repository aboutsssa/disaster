  deepTilling: `<svg viewBox="0 0 320 180" role="img" aria-label="土壤剖面、犁沟与劳作轨迹"><path class="motif-soil-layer" d="M28 64 C82 46 126 78 176 58 C218 42 252 54 292 38"/><path class="motif-soil-layer middle" d="M28 100 C78 82 122 114 172 96 C220 78 256 94 292 76"/><path class="motif-soil-layer dark" d="M28 136 C80 120 130 148 178 130 C222 114 260 128 292 112"/><path class="motif-furrow" d="M82 154 C98 124 122 96 158 70"/><path class="motif-furrow" d="M134 156 C150 126 178 98 214 74"/><path class="motif-tool" d="M210 32 L150 132"/><path class="motif-tool-head" d="M136 132 C156 126 170 138 180 154"/></svg>`,
  rainPreparedness: `<svg viewBox="0 0 320 180" role="img" aria-label="云线、雨势、针脚与织补纹理"><path class="motif-cloud" d="M48 62 C58 40 82 38 94 54 C108 30 144 38 148 66 C172 60 188 72 192 90 H48 C34 84 34 70 48 62 Z"/><path class="motif-cloud pale" d="M178 48 C190 30 214 34 222 52 C236 42 260 52 260 76 H178 C164 70 166 56 178 48 Z"/><path class="motif-rain" d="M78 100 L64 132"/><path class="motif-rain" d="M130 100 L116 132"/><path class="motif-rain" d="M224 92 L210 124"/><path class="motif-stitch" d="M54 148 C86 126 112 168 144 146 C176 124 204 166 238 144"/><path class="motif-stitch dash" d="M66 146 L76 154 M98 144 L108 152 M132 146 L142 154 M166 144 L176 152 M202 146 L212 154"/></svg>`,
  fiveGrains: `<svg viewBox="0 0 320 180" role="img" aria-label="多种谷物轮廓并置并逐渐模糊"><path class="motif-grain rice" d="M56 136 C52 98 62 68 84 42 C106 70 114 102 104 136"/><path class="motif-grain millet" d="M104 136 C110 100 126 74 154 54 C164 88 160 116 142 136"/><path class="motif-grain wheat" d="M170 136 L170 44 M156 64 L170 78 M184 64 L170 78 M154 88 L170 102 M188 88 L170 102"/><path class="motif-grain bean" d="M218 132 C192 118 194 86 220 76 C246 88 250 118 218 132 Z"/><path class="motif-grain blur" d="M244 138 C250 98 270 72 292 48 C298 92 286 120 264 138"/><rect class="motif-fog" x="198" y="36" width="88" height="110"/></svg>`,
  beansWheat: `<svg viewBox="0 0 320 180" role="img" aria-label="豆类与麦穗对照，中央边界逐渐消失"><g class="motif-beans"><ellipse cx="72" cy="82" rx="18" ry="26"/><ellipse cx="112" cy="100" rx="20" ry="28"/><path d="M66 78 C78 84 82 98 72 108"/><path d="M106 94 C120 102 124 116 112 126"/></g><path class="motif-boundary" d="M160 38 C152 70 172 98 160 142"/><g class="motif-wheat"><path d="M230 138 L230 46"/><path d="M214 62 L230 78"/><path d="M246 62 L230 78"/><path d="M212 88 L230 104"/><path d="M248 88 L230 104"/><path d="M216 114 L230 126"/><path d="M244 114 L230 126"/></g><path class="motif-mist" d="M126 60 C150 46 172 48 196 64 M122 94 C150 82 176 82 202 96 M128 126 C152 116 176 116 198 128"/></svg>`
};
---

<BaseLayout
  title={pageTitleZh}
  titleEn={pageTitleEn}
  titleZh={pageTitleZh}
  descriptionEn={descriptionEn}
  descriptionZh={descriptionZh}
  keywordsEn={keywordsEn.join(', ')}
  keywordsZh={keywordsZh.join(', ')}
  canonicalPath="/copresent-places/002/"
  ogType="article"
>
  <article class="lexical-page">
    <section class="lexical-hero">
      <p class="eyebrow" data-lang-en="Copresent Places 002" data-lang-zh="共时之地 002">共时之地 002</p>
      <div class="lexical-hero-grid">
        <div class="lexical-hero-copy">
          <p
            class="lexical-section-label"
            data-lang-en="Copresent Places"
            data-lang-zh="共时之地 / Copresent Places"
          >
            共时之地 / Copresent Places
          </p>
          <h1 data-lang-en={pageTitleEn} data-lang-zh={pageTitleZh}>{pageTitleZh}</h1>
          <p class="lexical-subtitle" data-lang-en={summaryEn} data-lang-zh={summaryZh}>{summaryZh}</p>
          <div class="lexical-tags" aria-label="Keywords">
            {
              keywordsZh.map((keyword, index) => (
                <span data-lang-en={keywordsEn[index]} data-lang-zh={keyword}>{keyword}</span>
              ))
            }
          </div>
          <div class="lexical-actions">
            <a href="#mechanism" data-lang-en="View mechanism" data-lang-zh="查看机制图">查看机制图</a>
            <a href="#lexicon" data-lang-en="Enter lexicon cabinet" data-lang-zh="进入词汇标本室">进入词汇标本室</a>
          </div>
        </div>
      </div>
      <p class="lexical-opening" data-lang-en={openingTextEn} data-lang-zh={openingTextZh}>{openingTextZh}</p>
    </section>

    <section class="lexical-section mechanism-section" id="mechanism">
      <div class="lexical-section-heading">
        <p class="eyebrow" data-lang-en="Mechanism" data-lang-zh="机制图">机制图</p>
        <h2 data-lang-en="From Embodied Experience to Hollowed Vocabulary" data-lang-zh="从身体经验到词汇空心化">
          从身体经验到词汇空心化
        </h2>
        <p data-lang-en={mechanismIntroEn} data-lang-zh={mechanismIntroZh}>{mechanismIntroZh}</p>
      </div>

      <!-- Mechanism timeline: a vertical narrative path of how experience is gradually abstracted. -->
      <div class="mechanism-timeline" aria-label="城市化与词汇空心化叙事时间线">
        <span class="mechanism-axis" aria-hidden="true">
          <span class="mechanism-axis-progress"></span>
        </span>
        {
          mechanismItems.map((item, index) => (
            <article class="mechanism-node" data-timeline-node>
              <div class="mechanism-marker">
                <span>{String(index + 1).padStart(2, '0')}</span>
              </div>
              <div class="mechanism-copy">
                <span class="mechanism-tag">{item.tag}</span>
                <h3 data-lang-en={item.titleEn} data-lang-zh={item.titleZh}>{item.titleZh}</h3>
                <p data-lang-en={item.textEn} data-lang-zh={item.textZh}>{item.textZh}</p>
                <p
                  class="mechanism-transition"
                  data-lang-en={item.transitionEn}
                  data-lang-zh={item.transitionZh}
                >
                  {item.transitionZh}
                </p>
              </div>
            </article>
          ))
        }
      </div>

      <aside class="theory-notes" aria-label="理论注脚">
        <p data-lang-en="Theory Notes" data-lang-zh="理论注脚 / Theory Notes">理论注脚 / Theory Notes</p>
        <ul>
          {theoryNotes.map((note) => <li data-lang-en={note.en} data-lang-zh={note.zh}>{note.zh}</li>)}
        </ul>
      </aside>
    </section>

    <section class="lexical-section lexicon-section" id="lexicon">
      <div class="lexical-section-heading">
        <p class="eyebrow" data-lang-en="Lexicon Cabinet" data-lang-zh="词汇标本室">词汇标本室</p>
        <h2 data-lang-en="Lexicon Cabinet" data-lang-zh="词汇标本室">词汇标本室</h2>
        <p data-lang-en={lexiconIntroEn} data-lang-zh={lexiconIntroZh}>{lexiconIntroZh}</p>
      </div>

      <div class="lexicon-toolbar" aria-label="词汇分类筛选">
        <button
          type="button"
          class="lexicon-filter-button is-active"
          data-category="all"
          data-lang-en="All"
          data-lang-zh="全部"
        >
          全部
        </button>
        {
          categories.map((category) => (
            <button
              type="button"
              class="lexicon-filter-button"
              data-category={category.zh}
              data-lang-en={category.en}
              data-lang-zh={category.zh}
            >
              {category.zh}
            </button>
          ))
        }
      </div>

      <div class="lexicon-grid" aria-live="polite">
        {
          lexiconEntries.map((entry, index) => (
            <article
              class="lexicon-card"
              data-category={entry.categoryZh}
              tabindex="0"
              aria-label={`${entry.wordZh} 词汇标本`}
            >
              <div class="lexicon-card-topline">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <span data-lang-en={entry.categoryEn} data-lang-zh={entry.categoryZh}>{entry.categoryZh}</span>
              </div>
              <div class="lexicon-card-body">
                <div class="lexicon-word-block">
                  <h3 data-lang-en={entry.wordEn} data-lang-zh={entry.wordZh}>{entry.wordZh}</h3>
                  <p data-lang-en={entry.summaryEn} data-lang-zh={entry.summaryZh}>{entry.summaryZh}</p>
                </div>
                <div class="lexicon-motif" set:html={motifSvgs[entry.motif]} />
              </div>
              <div class="lexicon-detail">
                <dl>
                  <div>
                    <dt data-lang-en="Original Place Experience" data-lang-zh="原初地方经验">原初地方经验</dt>
                    <dd data-lang-en={entry.originalExperienceEn} data-lang-zh={entry.originalExperienceZh}>
                      {entry.originalExperienceZh}
                    </dd>
                  </div>
                  <div>
                    <dt data-lang-en="Urbanized Drift" data-lang-zh="城市化后的漂移">城市化后的漂移</dt>
                    <dd data-lang-en={entry.urbanDriftEn} data-lang-zh={entry.urbanDriftZh}>{entry.urbanDriftZh}</dd>
                  </div>
                  <div>
                    <dt data-lang-en="Geographic Diagnosis" data-lang-zh="地理学诊断">地理学诊断</dt>
                    <dd data-lang-en={entry.diagnosisEn} data-lang-zh={entry.diagnosisZh}>{entry.diagnosisZh}</dd>
                  </div>
                </dl>
              </div>
              <div class="sense-tags" aria-label={`${entry.wordZh} 感官标签`}>
                {
                  entry.sensesZh.map((sense, senseIndex) => (
                    <span data-lang-en={entry.sensesEn[senseIndex]} data-lang-zh={sense}>{sense}</span>
                  ))
                }
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </article>

  <style>
    .lexical-page {
      background: var(--paper);
    }

    .lexical-hero,
    .lexical-section {
      max-width: 1180px;
      margin: 0 auto;
      padding-inline: clamp(1.25rem, 2vw, 2rem);
    }

    .lexical-hero {
      display: grid;
      gap: clamp(1.4rem, 3vw, 2.3rem);
      padding-top: clamp(3.5rem, 8vw, 6rem);
      padding-bottom: clamp(2.6rem, 5vw, 4rem);
      border-bottom: 1px solid rgba(200, 211, 206, 0.72);
    }

    .lexical-hero-grid {
      display: block;
    }

    .lexical-hero-copy {
      display: grid;
      gap: 1rem;
    }

    .lexical-section-label {
      margin: 0;
      color: #7b766d;
      font-size: 0.78rem;
      font-weight: 850;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .lexical-hero h1 {
      max-width: 30ch;
      font-size: clamp(2rem, 2.5vw, 3.2rem);
      line-height: 1.08;
    }

    .lexical-subtitle {
      max-width: 68ch;
      margin: 0;
      color: var(--muted);
      font-size: 1rem;
      line-height: 1.55;
    }

    .lexical-tags,
    .sense-tags,
    .lexical-actions,
    .lexicon-toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .lexical-tags span,
    .sense-tags span {
      color: #50645e;
      background: rgba(96, 138, 128, 0.11);
      border: 1px solid rgba(96, 138, 128, 0.14);
      font-size: 0.76rem;
      line-height: 1.2;
    }

    .lexical-tags span {
      padding: 0.22rem 0.48rem;
    }

    .lexical-actions {
      margin-top: 0.25rem;
    }

    .lexical-actions a {
      padding: 0.72rem 0.95rem;
      color: var(--forest);
      background: var(--white);
      border: 1px solid var(--line);
      font-size: 0.86rem;
      font-weight: 850;
      text-decoration: none;
    }

    .lexical-actions a:hover,
    .lexical-actions a:focus-visible {
      color: var(--white);
      background: var(--forest);
      outline: 0;
    }

    .lexicon-card dt {
      color: var(--brick);
      font-size: 0.68rem;
      font-weight: 850;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .lexicon-card dd {
      margin: 0.12rem 0 0;
      color: var(--muted);
      font-size: 0.88rem;
      line-height: 1.56;
    }

    .lexical-opening {
      max-width: 84ch;
      margin: 0;
      padding-top: clamp(1.1rem, 2vw, 1.6rem);
      color: var(--ink);
      border-top: 1px solid rgba(200, 211, 206, 0.72);
      font-size: 0.96rem;
      line-height: 1.78;
    }

    .lexical-section {
      padding-top: clamp(3rem, 6vw, 4.8rem);
      padding-bottom: clamp(2.8rem, 5vw, 4rem);
      border-bottom: 1px solid rgba(200, 211, 206, 0.72);
    }

    .lexical-section-heading {
      display: grid;
      gap: 0.8rem;
      max-width: 860px;
      margin-bottom: clamp(1.4rem, 3vw, 2rem);
    }

    .lexical-section-heading h2 {
      max-width: 36ch;
      font-size: clamp(1.4rem, 1.4vw, 2rem);
    }

    .lexical-section-heading p:last-child {
      margin: 0;
      color: var(--muted);
      font-size: 0.95rem;
      line-height: 1.72;
    }

    .mechanism-timeline {
      position: relative;
      display: grid;
      gap: clamp(2.4rem, 6vw, 4.7rem);
      max-width: 920px;
      margin-top: clamp(2rem, 4vw, 3rem);
      margin-left: clamp(0rem, 4vw, 4rem);
      padding: 0.2rem 0 0.2rem clamp(3.4rem, 6vw, 5.6rem);
    }

    .mechanism-axis {
      position: absolute;
      left: clamp(1rem, 2.4vw, 2.2rem);
      top: 0.4rem;
      bottom: 0.4rem;
      width: 1px;
      background: rgba(151, 135, 105, 0.28);
      overflow: hidden;
    }

    .mechanism-axis-progress {
      display: block;
      width: 100%;
      height: var(--timeline-progress, 0%);
      background: linear-gradient(180deg, rgba(162, 76, 56, 0.86), rgba(33, 77, 67, 0.44));
      transition: height 240ms ease-out;
    }

    .mechanism-node {
      position: relative;
      display: grid;
      grid-template-columns: 3.2rem minmax(0, 1fr);
      gap: clamp(1rem, 3vw, 2rem);
      align-items: start;
      opacity: 0;
      transform: translateY(22px);
      transition:
        opacity 520ms ease,
        transform 520ms ease;
    }

    .mechanism-node.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    .mechanism-marker {
      position: relative;
      z-index: 2;
      display: grid;
      place-items: center;
      width: 3.2rem;
      aspect-ratio: 1;
      color: rgba(33, 77, 67, 0.76);
      background: var(--paper);
      border: 1px solid rgba(151, 135, 105, 0.42);
      border-radius: 999px;
      box-shadow: 0 0 0 8px var(--paper);
      transition:
        color 260ms ease,
        background 260ms ease,
        border-color 260ms ease,
        box-shadow 260ms ease;
    }

    .mechanism-node.is-active .mechanism-marker {
      color: var(--white);
      background: var(--brick);
      border-color: var(--brick);
      box-shadow: 0 0 0 8px rgba(162, 76, 56, 0.11);
    }

    .mechanism-marker span,
    .lexicon-card-topline span:first-child {
      color: var(--brick);
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.35rem;
      font-style: italic;
      font-weight: 800;
      line-height: 1;
    }

    .mechanism-node.is-active .mechanism-marker span {
      color: var(--white);
    }

    .mechanism-copy {
      display: grid;
      gap: 0.72rem;
      max-width: 720px;
      padding: clamp(0.95rem, 2vw, 1.35rem) 0 clamp(1.1rem, 2vw, 1.55rem);
      border-bottom: 1px solid rgba(200, 211, 206, 0.72);
    }

    .mechanism-tag {
      width: fit-content;
      color: #746d63;
      font-size: 0.7rem;
      font-weight: 850;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .mechanism-copy h3 {
      color: var(--ink);
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(1.18rem, 1.35vw, 1.45rem);
      line-height: 1.14;
    }

    .mechanism-copy p {
      max-width: 68ch;
      margin: 0;
      color: var(--muted);
      font-size: 0.92rem;
      line-height: 1.66;
    }

    .mechanism-transition {
      color: var(--forest) !important;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1rem !important;
      font-style: italic;
      line-height: 1.46 !important;
    }

    .theory-notes {
      max-width: 780px;
      margin: clamp(2.4rem, 5vw, 4rem) 0 0 clamp(3.4rem, 6vw, 5.6rem);
      padding: 0.95rem 0 0 1.05rem;
      border-left: 1px solid rgba(162, 76, 56, 0.34);
    }

    .theory-notes > p {
      margin: 0 0 0.8rem;
      color: var(--brick);
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1rem;
      font-style: italic;
      font-weight: 800;
    }

    .theory-notes ul {
      display: grid;
      gap: 0.42rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .theory-notes li {
      color: var(--muted);
      font-size: 0.86rem;
      line-height: 1.68;
    }

    .theory-notes li::before {
      color: #b08a45;
      content: "§ ";
    }

    .lexicon-toolbar {
      position: sticky;
      top: 78px;
      z-index: 3;
      margin-bottom: 1.35rem;
      padding: 0.58rem 0;
      background: rgba(247, 247, 242, 0.92);
      backdrop-filter: blur(12px);
    }

    .lexicon-filter-button {
      padding: 0.42rem 0.62rem;
      color: var(--muted);
      background: var(--white);
      border: 1px solid var(--line);
      font: inherit;
      font-size: 0.76rem;
      font-weight: 800;
      cursor: pointer;
    }

    .lexicon-filter-button:hover,
    .lexicon-filter-button:focus-visible,
    .lexicon-filter-button.is-active {
      color: var(--white);
      background: var(--forest);
      border-color: var(--forest);
      outline: 0;
    }

    .lexicon-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(0.9rem, 2vw, 1.15rem);
    }

    .lexicon-card {
      display: grid;
      gap: 1rem;
      min-height: 440px;
      padding: clamp(1.05rem, 2vw, 1.35rem);
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.86), rgba(255, 255, 255, 0.98)),
        radial-gradient(circle at 82% 10%, rgba(195, 154, 69, 0.14), transparent 32%);
      border: 1px solid rgba(200, 211, 206, 0.92);
      box-shadow: 0 10px 26px rgba(29, 37, 40, 0.04);
      cursor: pointer;
      transition:
        opacity 220ms ease,
        transform 220ms ease,
        box-shadow 220ms ease,
        border-color 220ms ease;
    }

    .lexicon-card:hover,
    .lexicon-card:focus-visible,
    .lexicon-card.is-expanded {
      border-color: rgba(33, 77, 67, 0.32);
      box-shadow: 0 18px 42px rgba(29, 37, 40, 0.09);
      transform: translateY(-4px);
      outline: 0;
    }

    .lexicon-card.is-hiding {
      opacity: 0;
      transform: translateY(10px);
      pointer-events: none;
    }

    .lexicon-card[hidden] {
      display: none;
    }

    .lexicon-card-topline {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
    }

    .lexicon-card-topline span:last-child {
      color: #7b766d;
      font-size: 0.72rem;
      font-weight: 850;
      letter-spacing: 0.04em;
      text-align: right;
    }

    .lexicon-card-body {
      display: grid;
      gap: 0.9rem;
    }

    .lexicon-word-block {
      display: grid;
      gap: 0.55rem;
    }

    .lexicon-card h3 {
      color: var(--ink);
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(1.32rem, 1.5vw, 1.65rem);
      line-height: 1.12;
      transition: color 180ms ease;
    }

    .lexicon-card:hover h3,
    .lexicon-card:focus-visible h3,
    .lexicon-card.is-expanded h3 {
      color: var(--forest);
    }

    .lexicon-word-block p {
      margin: 0;
      color: var(--muted);
      font-size: 0.88rem;
      line-height: 1.62;
    }

    .lexicon-motif {
      position: relative;
      min-height: 190px;
      overflow: hidden;
      background:
        linear-gradient(90deg, rgba(33, 77, 67, 0.055) 1px, transparent 1px),
        linear-gradient(180deg, rgba(33, 77, 67, 0.045) 1px, transparent 1px),
        rgba(247, 247, 242, 0.78);
      background-size: 28px 28px;
      border: 1px solid rgba(200, 211, 206, 0.72);
    }

    .lexicon-motif::after {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: linear-gradient(120deg, transparent, rgba(255, 255, 255, 0.42), transparent);
      content: "";
      opacity: 0;
      transform: translateX(-34%);
      transition:
        opacity 260ms ease,
        transform 520ms ease;
    }

    .lexicon-card:hover .lexicon-motif::after,
    .lexicon-card:focus-visible .lexicon-motif::after,
    .lexicon-card.is-expanded .lexicon-motif::after {
      opacity: 0.7;
      transform: translateX(34%);
    }

    .lexicon-motif :global(svg) {
      width: 100%;
      height: 100%;
      min-height: 190px;
      display: block;
      opacity: 0.88;
      transition:
        opacity 220ms ease,
        transform 420ms ease;
    }

    .lexicon-card:hover .lexicon-motif :global(svg),
    .lexicon-card:focus-visible .lexicon-motif :global(svg),
    .lexicon-card.is-expanded .lexicon-motif :global(svg) {
      opacity: 1;
      transform: translateY(-3px) scale(1.025);
    }

    .lexicon-detail {
      display: grid;
      grid-template-rows: 0fr;
      opacity: 0;
      transition:
        grid-template-rows 260ms ease,
        opacity 220ms ease;
    }

    .lexicon-card:hover .lexicon-detail,
    .lexicon-card:focus-visible .lexicon-detail,
    .lexicon-card.is-expanded .lexicon-detail {
      grid-template-rows: 1fr;
      opacity: 1;
    }

