  </style>

  <script>
    const timeline = document.querySelector<HTMLElement>('.mechanism-timeline');
    const timelineNodes = Array.from(document.querySelectorAll<HTMLElement>('[data-timeline-node]'));
    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.lexicon-filter-button'));
    const lexiconCards = Array.from(document.querySelectorAll<HTMLElement>('.lexicon-card'));
    const filterTimers = new WeakMap<HTMLElement, number>();

    const setTimelineProgress = () => {
      if (!timeline) return;
      const rect = timeline.getBoundingClientRect();
      const viewportMarker = window.innerHeight * 0.58;
      const rawProgress = (viewportMarker - rect.top) / Math.max(rect.height, 1);
      const progress = Math.min(1, Math.max(0, rawProgress));
      timeline.style.setProperty('--timeline-progress', `${progress * 100}%`);
    };

    const timelineObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        entry.target.classList.toggle('is-visible', entry.isIntersecting);
        entry.target.classList.toggle('is-active', entry.isIntersecting && entry.intersectionRatio > 0.45);
      });
    }, { rootMargin: '-18% 0px -34% 0px', threshold: [0.16, 0.45, 0.7] });

    timelineNodes.forEach((node) => timelineObserver.observe(node));
    setTimelineProgress();
    window.addEventListener('scroll', setTimelineProgress, { passive: true });
    window.addEventListener('resize', setTimelineProgress);

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const category = button.dataset.category || 'all';
        filterButtons.forEach((item) => item.classList.toggle('is-active', item === button));
        lexiconCards.forEach((card) => {
          const isHidden = category !== 'all' && card.dataset.category !== category;
          card.setAttribute('aria-hidden', String(isHidden));
          const existingTimer = filterTimers.get(card);
          if (existingTimer) window.clearTimeout(existingTimer);

          if (isHidden) {
            card.classList.remove('is-expanded');
            card.classList.add('is-hiding');
            const timer = window.setTimeout(() => {
              card.hidden = true;
            }, 190);
            filterTimers.set(card, timer);
          } else {
            card.hidden = false;
            requestAnimationFrame(() => {
              card.classList.remove('is-hiding');
            });
          }
        });
      });
    });

    lexiconCards.forEach((card) => {
      card.addEventListener('click', () => {
        if (card.hidden || card.classList.contains('is-hiding')) return;
        card.classList.toggle('is-expanded');
      });

      card.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        card.click();
      });
    });
  </script>
</BaseLayout>
