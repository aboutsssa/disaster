---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../data/site';

const articles = [
  {
    href: '/copresent-places/001/',
    number: '001',
    dateEn: 'June 2026',
    dateZh: '2026年6月',
    tagsEn: ['Multispecies', 'Disaster care', 'Home'],
    tagsZh: ['多物种', '灾害关怀', '家'],
    titleEn: 'An Invisible Secondary Disaster: Pet Loss',
    titleZh: '看不见的次生灾害：宠物丧失',
    excerptEn: 'When home loses an animal, recovery no longer means return.',
    excerptZh: '突发灾难中，多物种关系如何改变我们对脆弱性、撤离与照护的理解。',
    keywordsEn:
      'multispecies geography · disaster care · home · public health · disenfranchised grief',
    keywordsZh: '多物种地理 · 灾害关怀 · 家 · 公共卫生 · 被剥夺的悲伤'
  }
];
---

<BaseLayout
  title="共时之地"
  titleEn="Copresent Places"
  titleZh="共时之地"
  descriptionEn="Copresent spatial experience and humanistic GIS."
  descriptionZh="共时地方经验与人文地理 GIS。"
>
  <section class="copresent-hero" aria-labelledby="copresent-title">
    <div class="copresent-title-row">
      <h1
        id="copresent-title"
        data-lang-en="Copresent Places"
        data-lang-zh="共时之地"
      >
        共时之地
      </h1>
    </div>
    <div class="copresent-intro">
      <p
        data-lang-en="A place is never only where it is. Life sees the infinite from within the finite. What the eye encounters may be simultaneous; what language can narrate is always successive. GIS, however, allows people, things, memories, and events from different times and places to meet on the same plane."
        data-lang-zh="一个地方从不只在它所在之处。我们的生活在有限中看见无限。眼睛所见可以是 simultaneous，而语言只能 successive。但GIS可以让不同时空的人事物相遇。"
      >
        我们的生活在有限中看见无限。眼睛所见可以是 simultaneous，而语言只能 successive。
      </p>
    </div>
  </section>

  <section class="article-index">
    <div class="article-index-heading">
      <p class="eyebrow" data-lang-en="Article Index" data-lang-zh="文章索引">文章索引</p>
    </div>

    <ol class="article-list">
      {
        articles.map((article) => (
          <li class="article-item">
            <a class="article-link" href={withBase(article.href)}>
              <div class="article-number">{article.number}</div>
              <div class="article-main">
                <div class="article-meta">
                  <time data-lang-en={article.dateEn} data-lang-zh={article.dateZh}>{article.dateZh}</time>
                  {article.statusEn && (
                    <span
                      class="article-status"
                      data-lang-en={article.statusEn}
                      data-lang-zh={article.statusZh}
                    >
                      {article.statusZh}
                    </span>
                  )}
                </div>

                <div class="article-tags">
                  {article.tagsZh.map((tag, index) => (
                    <span data-lang-en={article.tagsEn[index]} data-lang-zh={tag}>{tag}</span>
                  ))}
                </div>

                <h3 data-lang-en={article.titleEn} data-lang-zh={article.titleZh}>
                  {article.titleZh}
                </h3>
                <p class="article-excerpt" data-lang-en={article.excerptEn} data-lang-zh={article.excerptZh}>
                  {article.excerptZh}
                </p>

                <dl class="article-keywords">
                  <div>
                    <dt data-lang-en="Keywords" data-lang-zh="关键词">关键词</dt>
                    <dd>
                      <span data-lang-en={article.keywordsEn} data-lang-zh={article.keywordsZh}>
                        {article.keywordsZh}
                      </span>
                    </dd>
                  </div>
                </dl>
              </div>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
