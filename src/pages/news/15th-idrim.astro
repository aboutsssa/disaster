---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../data/site';

const titleZh = '参加第15届IDRiM国际会议并作学术报告';
const titleEn = 'Dr. Li presents at the 15th IDRiM International Conference';
---

<BaseLayout
  title={titleZh}
  titleEn={titleEn}
  titleZh={titleZh}
  descriptionEn="Dr. Li presented research on long-term reconstruction in earthquake-affected rural China at the 15th IDRiM International Conference."
  descriptionZh="黎博士参加第15届IDRiM国际会议并作灾后长期重建相关学术报告。"
>
  <article class="news-article news-article-page">
    <header class="news-article-hero">
      <a class="news-back-link" href={withBase('/news/')} data-lang-en="Back to News" data-lang-zh="返回动态">
        返回动态
      </a>
      <p class="eyebrow" data-lang-en="Conference" data-lang-zh="国际会议">国际会议</p>
      <h1 data-lang-en={titleEn} data-lang-zh={titleZh}>{titleZh}</h1>


    </header>

    <div class="news-article-shell">
      <div class="news-article-body">
        <p
          data-lang-en="The 15th annual conference of the International Society for Integrated Disaster Risk Management focused on disaster risk environments and response challenges faced by islands and remote areas under climate crisis and globalization. Scholars, policy makers, and practitioners from around the world gathered to discuss disaster risk perception, risk governance, sustainable development, and post-disaster recovery and reconstruction."
          data-lang-zh="第15届国际灾害风险管理学会（IDRiM Society）年会在希腊萨摩斯岛成功举办。本次大会以 “Advancing disaster risk reduction in islands and remote areas” 为主题，聚焦岛屿与偏远地区在气候危机与全球化背景下的灾害风险环境与应对挑战。来自全球的学者、政策制定者和实践者齐聚一堂，围绕灾害风险认知、风险治理、可持续发展与灾后恢复重建等议题展开深入交流。"
        >
          第15届国际灾害风险管理学会（IDRiM Society）年会在希腊萨摩斯岛成功举办。本次大会以 “Advancing disaster risk reduction in islands and remote areas” 为主题，聚焦岛屿与偏远地区在气候危机与全球化背景下的灾害风险环境与应对挑战。来自全球的学者、政策制定者和实践者齐聚一堂，围绕灾害风险认知、风险治理、可持续发展与灾后恢复重建等议题展开深入交流。
        </p>

        <p
          data-lang-en="Dr. Li was invited to present Integrating Heritage, Risk, and Resilience: Long-Term Reconstruction in Earthquake-Affected Rural China. Based on long-term fieldwork in the Dujiangyan Irrigation System World Heritage area, the study proposed a post-disaster recovery decision-making framework for historic settlements. It combines scenario planning, participatory GIS (PPGIS), and simulation modelling to explore how cultural landscape protection and sustainable development can be integrated in post-disaster reconstruction."
          data-lang-zh="黎博士应邀参会，报告题为《Integrating Heritage, Risk, and Resilience: Long-Term Reconstruction in Earthquake-Affected Rural China》。该研究基于在都江堰灌溉系统世界遗产地的长期实地调研，提出了面向历史聚落的灾后恢复决策框架。研究通过场景规划、参与式GIS（PPGIS）与模拟建模等多方法结合，探索如何在灾后重建中实现文化景观保护与可持续发展相结合。"
        >
          黎博士应邀参会，报告题为《Integrating Heritage, Risk, and Resilience: Long-Term Reconstruction in Earthquake-Affected Rural China》。该研究基于在都江堰灌溉系统世界遗产地的长期实地调研，提出了面向历史聚落的灾后恢复决策框架。研究通过场景规划、参与式GIS（PPGIS）与模拟建模等多方法结合，探索如何在灾后重建中实现文化景观保护与可持续发展相结合。
        </p>

        <p
          data-lang-en="The presentation emphasized the connection between bottom-up community voices and top-down policy guidance, showing how disaster recovery can become an opportunity for cultural heritage protection, landscape regeneration, and long-term resilience building."
          data-lang-zh="研究成果强调了自下而上社区声音与自上而下政策指导的衔接，展示了灾害恢复如何成为推动文化遗产保护、景观再生与长期韧性建设的重要契机。"
        >
          研究成果强调了自下而上社区声音与自上而下政策指导的衔接，展示了灾害恢复如何成为推动文化遗产保护、景观再生与长期韧性建设的重要契机。
        </p>

        <p
          data-lang-en="In international collaboration and early-career scholar development, Dr. Li was also selected for a women’s disaster risk reduction research and practice mentoring programme and was featured as a representative young member in the IDRiM annual report. Through the programme, Dr. Li maintained regular academic exchanges with Professor Funda Atun of the University of Twente on post-disaster recovery frameworks, sampling methods, data access, and long-term effect analysis, including a systematic discussion of forensic analysis methods for the Wenchuan earthquake."
          data-lang-zh="在国际合作与青年学者培养方面，黎博士还入选参加了女性防灾减灾科研与实践导师计划，并在IDRiM年度报告中作为代表性青年成员展示。在导师计划中，黎博士与荷兰特温特大学（University of Twente）Funda Atun 教授保持定期学术交流，围绕灾后恢复研究框架、取样方法、数据获取与长期效果分析展开深入讨论，特别针对汶川地震的法证分析（forensic analysis）方法进行了系统梳理。"
        >
          在国际合作与青年学者培养方面，黎博士还入选参加了女性防灾减灾科研与实践导师计划，并在IDRiM年度报告中作为代表性青年成员展示。在导师计划中，黎博士与荷兰特温特大学（University of Twente）Funda Atun 教授保持定期学术交流，围绕灾后恢复研究框架、取样方法、数据获取与长期效果分析展开深入讨论，特别针对汶川地震的法证分析（forensic analysis）方法进行了系统梳理。
        </p>

        <p
          data-lang-en="Dr. Li also served as mentor to Tlou Raphela from the University of the Free State in South Africa, holding regular online meetings on post-disaster recovery research, career development, and women’s participation in disaster risk reduction. The programme brings together women scholars globally and focuses on risk governance and research support through a gender perspective."
          data-lang-zh="同时，黎博士也担任来自南非自由州大学学者 Tlou Raphela 的导师，通过线上定期会议，就灾后恢复研究、职业发展路径和女性在防灾领域的参与展开互动交流。该计划汇聚全球女性学者，关注性别视角下的风险治理与科研支持。"
        >
          同时，黎博士也担任来自南非自由州大学学者 Tlou Raphela 的导师，通过线上定期会议，就灾后恢复研究、职业发展路径和女性在防灾领域的参与展开互动交流。该计划汇聚全球女性学者，关注性别视角下的风险治理与科研支持。
        </p>
      </div>

      <div class="news-article-gallery" aria-label="Conference photos">
        <figure>
          <img src={withBase('/assets/news/15th IDRiM/fig2.jpg')} alt="" loading="lazy" />
        </figure>
      </div>
    </div>
  </article>

  <style>
    .news-article-page {
      background: var(--paper);
    }

    .news-article-page .news-article-hero,
    .news-article-page .news-article-shell {
      width: min(60vw, 1060px);
      margin-inline: auto;
    }

    .news-article-page .news-article-hero {
      display: grid;
      gap: clamp(0.75rem, 1.5vw, 1.1rem);
      padding-block: clamp(3rem, 6vw, 5.4rem) clamp(1.6rem, 3vw, 2.4rem);
    }

    .news-article-page .news-back-link {
      width: fit-content;
      color: var(--forest);
      font-size: 0.86rem;
      font-weight: 850;
      text-decoration-thickness: 2px;
      text-underline-offset: 0.18em;
    }

    .news-article-page .news-article-hero h1 {
      max-width: 28ch;
      color: var(--ink);
      font-size: clamp(2.35rem, 2.6vw, 4.8rem);
      line-height: 0.98;
    }

    .news-article-page .news-article-lede {
      max-width: 72ch;
      margin: 0;
      color: #46504f;
      font-size: clamp(1rem, 1.2vw, 1.14rem);
      line-height: 1.68;
    }

    .news-article-page .news-article-meta {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0;
      margin: clamp(0.8rem, 2vw, 1.4rem) 0 0;
      border-block: 1px solid rgba(200, 211, 206, 0.92);
    }

    .news-article-page .news-article-meta div {
      display: grid;
      gap: 0.3rem;
      padding: 0.95rem 1rem;
      border-right: 1px solid rgba(200, 211, 206, 0.72);
    }

    .news-article-page .news-article-meta div:last-child {
      border-right: 0;
    }

    .news-article-page .news-article-meta dt,
    .news-article-page .news-article-meta dd {
      margin: 0;
    }

    .news-article-page .news-article-meta dt {
      color: var(--brick);
      font-size: 0.72rem;
      font-weight: 850;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .news-article-page .news-article-meta dd {
      color: var(--ink);
      font-size: 0.92rem;
      line-height: 1.45;
    }

    .news-article-page .news-article-shell {
      padding-bottom: clamp(4rem, 7vw, 6rem);
    }

    .news-article-page .news-article-body {
      display: grid;
      gap: 1.15rem;
    }

    .news-article-page .news-article-body p {
      max-width: 72ch;
      margin: 0;
      color: #26302f;
      font-size: clamp(1rem, 1.12vw, 1.1rem);
      line-height: 1.78;
    }

    .news-article-page .news-article-gallery {
      display: grid;
      gap: clamp(1rem, 2vw, 1.4rem);
      margin-top: clamp(2rem, 4vw, 3.2rem);
    }

    .news-article-page .news-article-gallery figure {
      margin: 0;
    }

    .news-article-page .news-article-gallery img {
      display: block;
      width: 70%;
      height: auto;
      border: 1px solid rgba(200, 211, 206, 0.92);
      background: var(--white);
    }

    @media (max-width: 900px) {
      .news-article-page .news-article-hero,
      .news-article-page .news-article-shell {
        width: auto;
        max-width: none;
        padding-inline: 1.25rem;
      }

      .news-article-page .news-article-hero h1 {
        max-width: 18ch;
        font-size: clamp(2.1rem, 12vw, 3.35rem);
      }

      .news-article-page .news-article-meta {
        grid-template-columns: 1fr;
      }

      .news-article-page .news-article-meta div {
        border-right: 0;
        border-bottom: 1px solid rgba(200, 211, 206, 0.72);
      }

      .news-article-page .news-article-meta div:last-child {
        border-bottom: 0;
      }
    }
  </style>
</BaseLayout>
