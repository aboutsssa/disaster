---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GlobalDisasterMap from '../../components/GlobalDisasterMap.astro';
import { withBase } from '../../data/site';
---

<BaseLayout
  title="全球灾害与复原空间观测平台"
  titleEn="Global Disaster and ReSpace Observatory"
  titleZh="全球灾害与复原空间观测平台"
  descriptionEn="A public atlas for exploring global hazards, population exposure, and post-disaster recovery conditions."
  descriptionZh="一个用于探索全球灾害、人口暴露与灾后恢复条件的公共交互图谱。"
>
  <section class="project-hero">
    <div>
      <p class="eyebrow" data-lang-en="Research Project" data-lang-zh="研究项目">研究项目</p>
      <h1
        data-lang-en="Global Disaster and ReSpace Observatory"
        data-lang-zh="全球灾害与复原空间观测平台"
      >
        全球灾害与复原空间观测平台
      </h1>
      <p
        data-lang-en="A data-driven atlas for exploring global hazards, population exposure, and post-disaster recovery conditions through live events and public geospatial layers."
        data-lang-zh="一个数据驱动的交互图谱，通过实时事件与公开地理空间图层展示全球灾害、人口暴露与灾后恢复条件。"
      >
        一个数据驱动的交互图谱，通过实时事件与公开地理空间图层展示全球灾害、人口暴露与灾后恢复条件。
      </p>
    </div>
    <div class="project-meta">
      <p>
        <strong data-lang-en="Map engine" data-lang-zh="地图引擎">地图引擎</strong>
        <span>MapLibre GL JS</span>
      </p>
      <p>
        <strong data-lang-en="Data model" data-lang-zh="数据模型">数据模型</strong>
        <span
          data-lang-en="Live events and public web layers"
          data-lang-zh="实时事件与公开 Web 图层"
        >
          实时事件与公开 Web 图层
        </span>
      </p>
      <p>
        <strong data-lang-en="Fullscreen app" data-lang-zh="全屏应用">全屏应用</strong>
        <span>
          <a href={withBase('/map/')} data-lang-en="Open map" data-lang-zh="打开地图">打开地图</a>
        </span>
      </p>
    </div>
  </section>

  <GlobalDisasterMap showcase />
</BaseLayout>
