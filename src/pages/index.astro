---
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { recoveryDimensions, researchThemes, site, withBase } from '../data/site';
---

<BaseLayout
  title="Home"
  description="ReSpace Lab explores post-disaster recovery, resilience building, and spatial governance."
>
  <PageHero
    eyebrow={site.owner}
    title="ReSpace Lab"
    text="恢复空间实验室致力于探索灾后恢复、韧性建设与空间治理的交叉议题，立足地理学视角，融合参与式GIS、遥感技术、系统建模与因果推断等方法，研究灾后空间重构、人地系统复原机制与城乡规划响应路径。"
    image="https://images.unsplash.com/photo-1518005020951-eccb494ad742?auto=format&fit=crop&w=1400&q=80"
  />

  <section class="intro-band">
    <div>
      <p class="eyebrow">Lab Mission</p>
      <h2>从灾后重建到复原空间 Re-Space</h2>
    </div>
    <p>
      我们关注的不只是重建“空间”，而是重塑具有社会适应力、生态承载力与文化连续性的复原空间。
      实验室强调数据驱动与公众参与并重，致力于推动更公平、可持续、在地化的灾后治理与人居环境重建。
      围绕灾后重建与韧性城乡空间治理，ReSpace Lab 组建融合地理学、城乡规划、
      灾害风险管理与数据科学的青年研究团队。实验室强化实地调查、空间分析与政策实验
      三位一体的实践能力，连接理论研究、课程训练与公共服务。
    </p>
  </section>

  <section class="content-grid">
    {
      researchThemes.map((theme) => (
        <article class="theme-card">
          <p class="eyebrow">{theme.eyebrow}</p>
          <h3>{theme.title}</h3>
          <p>{theme.description}</p>
        </article>
      ))
    }
  </section>

  <section class="split-section">
    <div>
      <p class="eyebrow">Framework</p>
      <h2>复原空间的四个维度</h2>
      <p>
        在长期灾后恢复实践基础上，实验室把空间科学方法引入恢复经济学与灾害研究，
        关注恢复公平性、文化景观、人居环境与区域韧性之间的耦合关系。
      </p>
    </div>
    <ol class="dimension-list">
      {recoveryDimensions.map((dimension) => <li>{dimension}</li>)}
    </ol>
  </section>

  <section class="project-callout">
    <div>
      <p class="eyebrow">Featured Project</p>
      <h2>Global Disaster & ReSpace Observatory</h2>
      <p>
        Explore a MapLibre-based research observatory for comparing live earthquake events,
        population exposure, flood risk, fire activity, and future Earth Engine-derived
        recovery and spatial governance layers.
      </p>
    </div>
    <a href={withBase('/projects/global-disaster-map/')}>Open project</a>
  </section>

  <section class="project-callout">
    <div>
      <p class="eyebrow">Data Application</p>
      <h2>Wenchuan Recovery Atlas</h2>
      <p>
        Read a 2000-2020 Sichuan county panel as a disaster story of earthquake impact,
        reconstruction, ecological recovery, air pressure, and uneven spatial recovery.
      </p>
    </div>
    <a href={withBase('/wenchuan/')}>Open atlas</a>
  </section>
</BaseLayout>
