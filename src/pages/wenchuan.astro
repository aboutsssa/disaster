---
import WenchuanRecoveryAtlas from '../components/WenchuanRecoveryAtlas.astro';
import { site } from '../data/site';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Fullscreen Wenchuan earthquake recovery atlas built from Sichuan county-year panel data."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Wenchuan Recovery Atlas | {site.name}</title>
  </head>
  <body class="fullscreen-map-page">
    <WenchuanRecoveryAtlas fullscreen />
  </body>
</html>
