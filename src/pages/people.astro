---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../data/site';

type Person = {
  nameEn: string;
  nameZh: string;
  titleEn: string;
  titleZh: string;
  interestsEn: string;
  interestsZh: string;
  initials: string;
  image?: string;
  url?: string;
};

const lead: Person = {
  nameEn: 'Qiushan Li',
  nameZh: '黎秋杉',
  titleEn: 'Lab Director · PhD · Associate Researcher, Sichuan University IDMR',
  titleZh: '实验室负责人 · 博士 · 四川大学 IDMR 副研究员',
  interestsEn: 'Disaster Recovery, Participatory GIS, Vernacular Landscape',
  interestsZh: '灾后恢复、参与式 GIS、乡土景观',
  initials: 'QL',
  image: '/assets/qiushan-li-portrait.jpg',
  url: 'https://idmr.scu.edu.cn/en/info/1102/1210.htm'
};

const masterStudents: Person[] = [
  {
    nameEn: 'Rongjia Li',
    nameZh: '李荣佳',
    initials: 'LR',
    titleEn: 'Master Student',
    titleZh: '硕士研究生',
    interestsEn: 'Urban and Rural Planning, Ecological Settlement Design',
    interestsZh: '城乡规划、生态聚落设计',
    image: '/assets/rongjia-li-portalit.jpg'
  },
  ['Yun Chen', '陈芸', 'CY'],
  ['Zhuo Li', '李卓', 'LZ'],
  ['Xue Han', '韩雪', 'HX'],
  ['Quanwei Liu', '刘泉蔚', 'LQ'],
  ['Jiuwei Yu', '余玖蔚', 'YJ']
].map((person) =>
  Array.isArray(person)
    ? {
        nameEn: person[0],
        nameZh: person[1],
        initials: person[2],
        titleEn: 'Master Student',
        titleZh: '硕士研究生',
        interestsEn: 'Research interests to be updated.',
        interestsZh: '研究兴趣待更新。'
      }
    : person
);

const undergraduateStudents: Person[] = [
  ['Xiaozihan Wang', '王肖子涵', 'WX'],
  ['Hongyu Gong', '龚红宇', 'GH'],
  ['Yujing Zheng', '郑雨静', 'ZY'],
  ['Zihao Wang', '王子豪', 'WZ'],
  ['Yaxuan Wang', '王雅璇', 'WY'],
  ['Zhixin Zeng', '曾智鑫', 'ZZ'],
  ['Yibei Wang', '王艺蓓', 'WY'],
  ['Jiayi Wang', '王嘉怡', 'WJ']
].map(([nameEn, nameZh, initials]) => ({
  nameEn,
  nameZh,
  initials,
  titleEn: 'Undergraduate Student',
  titleZh: '本科生',
  interestsEn: 'Research interests to be updated.',
  interestsZh: '研究兴趣待更新。'
}));

const collaboratorNote = {
  titleEn: 'Collaborators / Participants',
  titleZh: '合作者 / 参与者',
  textEn:
    'External collaborators, field partners, visiting students, and project participants can be added here as the lab network grows.',
  textZh: '外部合作者、田野伙伴、访问学生与项目参与者可在此继续添加。'
};

const sections = [
  {
    eyebrowEn: 'Master Students',
    eyebrowZh: '硕士研究生',
    titleEn: 'Graduate researchers',
    titleZh: '硕士研究生',
    people: masterStudents
  },
  {
    eyebrowEn: 'Undergraduate Students',
    eyebrowZh: '本科生',
    titleEn: 'Undergraduate researchers',
    titleZh: '本科生',
    people: undergraduateStudents
  }
];
---

<BaseLayout title="团队" titleEn="People" titleZh="团队">
  <section class="people-hero" aria-labelledby="people-title">
    <div>
      <p class="eyebrow" data-lang-en="People" data-lang-zh="团队">团队</p>
      <h1
        id="people-title"
        data-lang-en="ReSpace Lab Members"
        data-lang-zh="ReSpace Lab 团队成员"
      >
        ReSpace Lab 团队成员
      </h1>
    </div>
    <p
      data-lang-en="A growing research group for post-disaster recovery, participatory GIS, vernacular landscape studies, and resilient spatial governance."
      data-lang-zh="一个围绕灾后恢复、参与式 GIS、乡土景观研究与韧性空间治理持续成长的研究团队。"
    >
      一个围绕灾后恢复、参与式 GIS、乡土景观研究与韧性空间治理持续成长的研究团队。
    </p>
  </section>

  <section class="people-section people-lead-section" aria-label="Lab director">
    <div class="people-section-heading">
      <p class="eyebrow" data-lang-en="Director" data-lang-zh="负责人">负责人</p>
      <h2 data-lang-en="Director" data-lang-zh="负责人">负责人</h2>
    </div>

    <div class="member-grid is-single">
      <a
        class="member-card is-director"
        href={lead.url}
        target="_blank"
        rel="noreferrer"
        aria-label="Qiushan Li profile"
      >
        <div class="member-photo">
          {
            lead.image ? (
              <>
                <img
                  src={withBase(lead.image)}
                  alt=""
                  loading="lazy"
                  onerror="this.remove()"
                />
                <span>{lead.initials}</span>
              </>
            ) : (
              <span>{lead.initials}</span>
            )
          }
        </div>
        <div class="member-copy">
          <h3 data-lang-en={lead.nameEn} data-lang-zh={lead.nameZh}>{lead.nameZh}</h3>
          <p class="member-title" data-lang-en={lead.titleEn} data-lang-zh={lead.titleZh}>
            {lead.titleZh}
          </p>
          <p
            class="member-interest"
            data-lang-en={lead.interestsEn}
            data-lang-zh={lead.interestsZh}
          >
            {lead.interestsZh}
          </p>
        </div>
      </a>
    </div>
  </section>

  {
    sections.map((section) => (
      <section class="people-section">
        <div class="people-section-heading">
          <p class="eyebrow" data-lang-en={section.eyebrowEn} data-lang-zh={section.eyebrowZh}>
            {section.eyebrowZh}
          </p>
          <h2 data-lang-en={section.titleEn} data-lang-zh={section.titleZh}>
            {section.titleZh}
          </h2>
        </div>

        <div class="member-grid">
          {section.people.map((person) =>
            person.url ? (
              <a class="member-card" href={person.url} target="_blank" rel="noreferrer">
                <div class="member-photo">
                  {person.image ? (
                    <>
                      <img
                        src={withBase(person.image)}
                        alt=""
                        loading="lazy"
                        onerror="this.remove()"
                      />
                      <span>{person.initials}</span>
                    </>
                  ) : (
                    <span>{person.initials}</span>
                  )}
                </div>
                <div class="member-copy">
                  <h3 data-lang-en={person.nameEn} data-lang-zh={person.nameZh}>
                    {person.nameZh}
                  </h3>
                  <p class="member-title" data-lang-en={person.titleEn} data-lang-zh={person.titleZh}>
                    {person.titleZh}
                  </p>
                  <p
                    class="member-interest"
                    data-lang-en={person.interestsEn}
                    data-lang-zh={person.interestsZh}
                  >
                    {person.interestsZh}
                  </p>
                </div>
              </a>
            ) : (
              <article class="member-card">
                <div class="member-photo">
                  {person.image ? (
                    <>
                      <img
                        src={withBase(person.image)}
                        alt=""
                        loading="lazy"
                        onerror="this.remove()"
                      />
                      <span>{person.initials}</span>
                    </>
                  ) : (
                    <span>{person.initials}</span>
                  )}
                </div>
                <div class="member-copy">
                  <h3 data-lang-en={person.nameEn} data-lang-zh={person.nameZh}>
                    {person.nameZh}
                  </h3>
                  <p class="member-title" data-lang-en={person.titleEn} data-lang-zh={person.titleZh}>
                    {person.titleZh}
                  </p>
                  <p
                    class="member-interest"
                    data-lang-en={person.interestsEn}
                    data-lang-zh={person.interestsZh}
                  >
                    {person.interestsZh}
                  </p>
                </div>
              </article>
            )
          )}
        </div>
      </section>
    ))
  }

  <section class="people-section">
    <div class="people-section-heading">
      <p
        class="eyebrow"
        data-lang-en={collaboratorNote.titleEn}
        data-lang-zh={collaboratorNote.titleZh}
      >
        {collaboratorNote.titleZh}
      </p>
      <h2 data-lang-en="Project network" data-lang-zh="项目网络">项目网络</h2>
    </div>
    <article class="collaborator-panel">
      <p data-lang-en={collaboratorNote.textEn} data-lang-zh={collaboratorNote.textZh}>
        {collaboratorNote.textZh}
      </p>
    </article>
  </section>
</BaseLayout>
