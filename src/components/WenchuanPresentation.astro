      center: [lng * 0.42, Math.max(Math.min(lat * 0.42, 30), -30)],
      zoom: 1.45,
      speed: 0.42,
      curve: 1.35,
      essential: true
    });
    window.setTimeout(() => {
      titleGlobe?.flyTo({
        center: [lng, lat],
        zoom: 4.45,
        speed: 0.58,
        curve: 1.22,
        essential: true
      });
    }, 1600);
  };

  const initTitleGlobe = () => {
    if (!titleGlobeContainer || titleGlobe) return;
    try {
      titleGlobe = new maplibregl.Map({
        container: titleGlobeContainer,
        style: {
          version: 8,
          sources: {
            basemap: {
              type: 'raster',
              tiles: [
                'https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}'
              ],
              tileSize: 256,
              attribution: ''
            },
            cases: {
              type: 'geojson',
              data: {
                type: 'FeatureCollection',
                features: titleGlobeCases.map((item) => ({
                  type: 'Feature',
                  geometry: { type: 'Point', coordinates: item.coordinates },
                  properties: { year: item.year }
                }))
              }
            }
          },
          layers: [
            {
              id: 'basemap',
              type: 'raster',
              source: 'basemap',
              paint: {
                'raster-opacity': 0.76,
                'raster-saturation': -0.78,
                'raster-contrast': 0.12,
                'raster-brightness-min': 0,
                'raster-brightness-max': 0.7
              }
            }
          ]
        },
        center: [86, 27],
        zoom: 1.45,
        interactive: false,
        attributionControl: false
      });
      titleGlobe.on('style.load', () => {
        try {
          titleGlobe.setProjection({ type: 'globe' });
        } catch {
          // MapLibre globe may be unavailable in older renderers; the raster map still works.
        }
        titleGlobe.addLayer({
          id: 'title-disaster-heat',
          type: 'heatmap',
          source: 'cases',
          paint: {
            'heatmap-weight': 1,
            'heatmap-intensity': 1.2,
            'heatmap-color': [
              'interpolate',
              ['linear'],
              ['heatmap-density'],
              0,
              'rgba(0,0,0,0)',
              0.35,
              'rgba(217,180,109,0.35)',
              0.75,
              'rgba(199,111,126,0.72)',
              1,
              'rgba(255,248,234,0.86)'
            ],
            'heatmap-radius': ['interpolate', ['linear'], ['zoom'], 1, 14, 5, 32],
            'heatmap-opacity': 0.72
          }
        });
        titleGlobe.addLayer({
          id: 'title-disaster-points',
          type: 'circle',
          source: 'cases',
          paint: {
            'circle-radius': ['interpolate', ['linear'], ['zoom'], 1, 3, 5, 7],
            'circle-color': '#d9b46d',
            'circle-stroke-color': 'rgba(255,248,234,0.82)',
            'circle-stroke-width': 1,
            'circle-opacity': 0.92
          }
        });
        flyTitleGlobe();
        titleGlobeTimer = window.setInterval(flyTitleGlobe, 6800);
      });
    } catch {
      titleGlobeContainer.classList.add('is-fallback');
      titleGlobeContainer.innerHTML = `<span>${t('fallbackGlobe')}</span>`;
      updateTitleGlobeCaption(titleGlobeCases[0]);
    }
  };

  const fmtUsd = (value) => {
    const sign = value < 0 ? '-' : '';
    const absolute = Math.abs(value);
    if (absolute >= 1000) return `${sign}$${(absolute / 1000).toFixed(absolute >= 10000 ? 0 : 1)}k`;
    return `${sign}$${Math.round(absolute)}`;
  };

  const scale = (value, domain, range) => {
    const [min, max] = domain;
    const [start, end] = range;
    return start + ((value - min) / (max - min || 1)) * (end - start);
  };

  const domainFor = (series) => {
    const values = series.flat().filter(Number.isFinite);
    const min = Math.min(...values);
    const max = Math.max(...values);
    const pad = (max - min || 1) * 0.14;
    return [min - pad, max + pad];
  };

  const pathFor = (series, box, domain) =>
    series.map((value, index) => {
      const x = scale(years[index], [2000, 2020], [box.x, box.x + box.w]);
      const y = scale(value, domain, [box.y + box.h, box.y]);
      return `${index === 0 ? 'M' : 'L'}${x.toFixed(1)},${y.toFixed(1)}`;
    }).join(' ');

  const countyNames = {
    安州区: { en: 'Anzhou', zh: '安州', hi: 'अन्झोउ' },
    北川县: { en: 'Beichuan', zh: '北川', hi: 'बेइचुआन' },
    都江堰市: { en: 'Dujiangyan', zh: '都江堰', hi: 'दुजियांगयान' },
    茂县: { en: 'Mao', zh: '茂县', hi: 'माओ' },
    绵竹市: { en: 'Mianzhu', zh: '绵竹', hi: 'मियानझू' },
    彭州市: { en: 'Pengzhou', zh: '彭州', hi: 'पेंगझोउ' },
    平武县: { en: 'Pingwu', zh: '平武', hi: 'पिंगवू' },
    青川县: { en: 'Qingchuan', zh: '青川', hi: 'छिंगचुआन' },
    什邡市: { en: 'Shifang', zh: '什邡', hi: 'शिफांग' },
    汶川县: { en: 'Wenchuan', zh: '汶川', hi: 'वेनचुआन' }
  };

  const countyLabel = (county) => countyNames[county]?.[language] ?? countyNames[county]?.en ?? county;

  const drawChart = (targetId, unit, title, tone = 'neutral') => {
    const svg = document.getElementById(targetId);
    if (!svg || !unit) return;
    const box = { x: 72, y: 54, w: 560, h: 278 };
    const domain = domainFor([unit.actual, unit.synthetic]);
    const ticks = [2000, 2008, 2020];
    const yTicks = [domain[0], (domain[0] + domain[1]) / 2, domain[1]];
    const shockX = scale(2008, [2000, 2020], [box.x, box.x + box.w]);
    const endActualY = scale(unit.actual.at(-1), domain, [box.y + box.h, box.y]);
    const endSyntheticY = scale(unit.synthetic.at(-1), domain, [box.y + box.h, box.y]);
    svg.innerHTML = `
      <rect class="deck-chart-frame" x="${box.x}" y="${box.y}" width="${box.w}" height="${box.h}" />
      ${yTicks.map((tick) => {
        const y = scale(tick, domain, [box.y + box.h, box.y]);
        return `<line class="deck-chart-guide" x1="${box.x}" x2="${box.x + box.w}" y1="${y}" y2="${y}" />
          <text class="deck-chart-tick y" x="${box.x - 14}" y="${y + 4}">${fmtUsd(tick)}</text>`;
      }).join('')}
      ${ticks.map((year) => {
        const x = scale(year, [2000, 2020], [box.x, box.x + box.w]);
        return `<text class="deck-chart-tick" x="${x}" y="${box.y + box.h + 30}">${year}</text>`;
      }).join('')}
      <line class="deck-shock" x1="${shockX}" x2="${shockX}" y1="${box.y}" y2="${box.y + box.h}" />
      <text class="deck-shock-label" x="${shockX + 8}" y="${box.y + 18}">${t('earthquake2008')}</text>
      <path class="deck-line synthetic" d="${pathFor(unit.synthetic, box, domain)}" />
      <path class="deck-line actual ${tone}" d="${pathFor(unit.actual, box, domain)}" />
      <text class="deck-series actual" x="${box.x + box.w + 18}" y="${endActualY + 4}">${t('actual')}</text>
      <text class="deck-series synthetic" x="${box.x + box.w + 18}" y="${endSyntheticY + 4}">${t('synthetic')}</text>
      <text class="deck-chart-title" x="${box.x}" y="${box.y - 22}">${title}</text>
      <text class="deck-chart-note" x="${box.x}" y="${box.y + box.h + 62}">${t('gdpNote')} · ${t('postGapAvg')} ${fmtUsd(unit.postGap)}</text>
    `;
  };

  const drawTenCounties = () => {
    const svg = document.getElementById('chart-ten-counties');
    if (!svg) return;
    const counties = data.groups.extreme.counties;
    const units = counties.map((county) => data.groups.extreme.outcomes.real_gdp_pc.units[county]);
    const domain = domainFor(units.flatMap((unit) => [unit.actual, unit.synthetic]));
    const boxes = counties.map((county, index) => ({
      county,
      x: 42 + (index % 5) * 154,
      y: 56 + Math.floor(index / 5) * 188,
      w: 116,
      h: 104
    }));
    svg.innerHTML = boxes.map((box) => {
      const unit = data.groups.extreme.outcomes.real_gdp_pc.units[box.county];
      const tone = unit.postGap >= 0 ? 'positive' : 'negative';
      const shockX = scale(2008, [2000, 2020], [box.x, box.x + box.w]);
      return `
        <g class="mini-county ${tone}">
          <rect class="mini-frame" x="${box.x}" y="${box.y}" width="${box.w}" height="${box.h}" />
          <line class="mini-shock" x1="${shockX}" x2="${shockX}" y1="${box.y}" y2="${box.y + box.h}" />
          <path class="mini-line synthetic" d="${pathFor(unit.synthetic, box, domain)}" />
          <path class="mini-line actual ${tone}" d="${pathFor(unit.actual, box, domain)}" />
          <text class="mini-title" x="${box.x}" y="${box.y - 10}">${countyLabel(box.county)}</text>
          <text class="mini-gap" x="${box.x + box.w}" y="${box.y + box.h + 20}">${fmtUsd(unit.postGap)}</text>
        </g>
      `;
    }).join('') + `<text class="mini-caption" x="42" y="432">${t('countyMatrixCaption')}</text>`;
  };

  const drawIntensity = () => {
    const svg = document.getElementById('chart-intensity');
    if (!svg) return;
    const groups = [
      { id: 'extreme', label: t('extreme'), color: '#c76f7e' },
      { id: 'severe', label: t('severe'), color: '#d9b46d' },
      { id: 'general', label: t('general'), color: '#8db7d2' }
    ];
    const box = { x: 72, y: 54, w: 560, h: 278 };
    const series = groups.map((group) => data.groups[group.id].outcomes.real_gdp_pc.average.gap);
    const domain = domainFor(series);
    const zeroY = scale(0, domain, [box.y + box.h, box.y]);
    svg.innerHTML = `
      <rect class="deck-chart-frame" x="${box.x}" y="${box.y}" width="${box.w}" height="${box.h}" />
      <line class="deck-zero" x1="${box.x}" x2="${box.x + box.w}" y1="${zeroY}" y2="${zeroY}" />
      ${[-1000, 0, 1000].map((tick) => {
        const y = scale(tick, domain, [box.y + box.h, box.y]);
        return `<text class="deck-chart-tick y" x="${box.x - 14}" y="${y + 4}">${fmtUsd(tick)}</text>`;
      }).join('')}
      ${[2000, 2008, 2020].map((year) => {
        const x = scale(year, [2000, 2020], [box.x, box.x + box.w]);
        return `<text class="deck-chart-tick" x="${x}" y="${box.y + box.h + 30}">${year}</text>`;
      }).join('')}
      ${groups.map((group) => {
        const unit = data.groups[group.id].outcomes.real_gdp_pc.average;
        const y = scale(unit.gap.at(-1), domain, [box.y + box.h, box.y]);
        return `
          <path class="deck-line intensity" style="--stroke:${group.color}" d="${pathFor(unit.gap, box, domain)}" />
          <text class="deck-series intensity" style="--fill:${group.color}" x="${box.x + box.w + 18}" y="${y + 4}">${group.label}</text>
        `;
      }).join('')}
      <text class="deck-chart-title" x="${box.x}" y="${box.y - 22}">${t('intensityTitle')}</text>
      <text class="deck-chart-note" x="${box.x}" y="${box.y + box.h + 62}">${t('intensityNote')}</text>
    `;
  };

  const unitFor = (county) => data.groups.extreme.outcomes.real_gdp_pc.units[county];

  const setStoryNumbers = () => {
    const anzhou = unitFor('安州区');
    const wenchuan = unitFor('汶川县');
    const mianzhu = unitFor('绵竹市');
    document.getElementById('story-anzhou').textContent = t('anzhouStory')(fmtUsd(anzhou.gap[9]), fmtUsd(anzhou.gap.at(-1)));
    document.getElementById('story-wenchuan').textContent = t('wenchuanStory')(fmtUsd(wenchuan.postGap), fmtUsd(wenchuan.gap.at(-1)));
    document.getElementById('story-mianzhu').textContent = t('mianzhuStory')(fmtUsd(mianzhu.gap.at(-1)));
    const extreme = data.groups.extreme.outcomes.real_gdp_pc.average;
    const severe = data.groups.severe.outcomes.real_gdp_pc.average;
    const general = data.groups.general.outcomes.real_gdp_pc.average;
    document.getElementById('story-intensity').textContent =
      t('intensityStory')(fmtUsd(extreme.postGap), fmtUsd(severe.postGap), fmtUsd(general.postGap));
  };

  const drawAll = () => {
    const average = data.groups.extreme.outcomes.real_gdp_pc.average;
    drawTenCounties();
    drawChart('chart-average', average, t('averageTitle'), average.postGap >= 0 ? 'positive' : 'negative');
    drawIntensity();
    drawChart('chart-anzhou', unitFor('安州区'), t('anzhouTitle'), 'positive');
    drawChart('chart-wenchuan', unitFor('汶川县'), t('wenchuanTitle'), 'positive');
    drawChart('chart-mianzhu', unitFor('绵竹市'), t('mianzhuTitle'), 'negative');
    setStoryNumbers();
  };

  const showSlide = (index) => {
    const previous = current;
    current = Math.max(0, Math.min(slides.length - 1, index));
    deck.dataset.direction = current >= previous ? 'forward' : 'backward';
    slides.forEach((slide, slideIndex) => {
      slide.classList.toggle('is-active', slideIndex === current);
      slide.classList.toggle('is-before', slideIndex < current);
      slide.classList.toggle('is-after', slideIndex > current);
    });
    slideCount.textContent = `${current + 1} / ${slides.length}`;
    progress.style.width = `${((current + 1) / slides.length) * 100}%`;
    deck.dataset.index = String(current + 1);
  };

  prevButton.addEventListener('click', () => showSlide(current - 1));
  nextButton.addEventListener('click', () => showSlide(current + 1));
  languageButtons.forEach((button) => {
    button.addEventListener('click', () => {
      applyLanguage(button.dataset.slideLanguage);
      window.dispatchEvent(new CustomEvent('respace-language-change', { detail: { language } }));
    });
  });
  window.addEventListener('respace-language-change', (event) => {
    if (event.detail?.language && event.detail.language !== language) {
      applyLanguage(event.detail.language);
    }
  });
  window.addEventListener('keydown', (event) => {
    if (['ArrowRight', 'PageDown', ' '].includes(event.key)) {
      event.preventDefault();
      showSlide(current + 1);
    }
    if (['ArrowLeft', 'PageUp'].includes(event.key)) {
      event.preventDefault();
      showSlide(current - 1);
    }
  });

  applyLanguage(language);

  fetch(`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}data/wenchuan-scm-results.json`)
    .then((response) => response.json())
    .then((payload) => {
      data = payload;
      applyLanguage(language);
      drawAll();
      initTitleGlobe();
      showSlide(0);
    });
</script>
