    titleGlobeYear.textContent = item.year;
    titleGlobeName.textContent = name;
    titleGlobePlace.textContent = place;
  };

  const flyTitleGlobe = () => {
    if (!titleGlobe) return;
    const item = titleGlobeCases[titleGlobeIndex % titleGlobeCases.length];
    titleGlobeIndex = (titleGlobeIndex + 1) % titleGlobeCases.length;
    updateTitleGlobeCaption(item);
