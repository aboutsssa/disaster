---
import { geePlan, observatoryLayers } from '../data/disasterProjects';
import 'maplibre-gl/dist/maplibre-gl.css';

interface Props {
  fullscreen?: boolean;
  showcase?: boolean;
}

const { fullscreen = false, showcase = false } = Astro.props;
const assetUrl = (path: string) =>
  `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${path.replace(/^\//, '')}`;

const layerCopy = {
  population: {
    en: 'Population',
    zh: '人口分布',
    noteEn: 'Where people concentrate',
    noteZh: '人口最密集的地方'
  },
  'flood-risk': {
    en: 'Flood',
    zh: '洪水',
    noteEn: 'Places exposed to flooding',
    noteZh: '可能受洪水影响的区域'
  },
  'urban-heat': {
    en: 'Heat',
    zh: '高温',
    noteEn: 'Urban heat stress',
    noteZh: '城市热压力'
  },
  'active-fire': {
    en: 'Fire',
    zh: '火灾',
    noteEn: 'Active fire signals',
    noteZh: '正在发生的火点信号'
  },
  'hurricane-tracks': {
    en: 'Hurricane',
    zh: '飓风',
    noteEn: 'Storm paths',
    noteZh: '风暴移动路径'
  },
  'tsunami-events': {
    en: 'Tsunami',
    zh: '海啸',
    noteEn: 'Historical tsunami events',
    noteZh: '历史海啸事件'
  },
  earthquakes: {
    en: 'Earthquake',
    zh: '地震',
    noteEn: 'Recent seismic activity',
    noteZh: '近期地震活动'
  }
};
---

<section
  class:list={['observatory-shell', fullscreen && 'is-fullscreen', showcase && 'is-showcase']}
  aria-label="Global disaster and re-inhabitability observatory"
>
  <aside class="observatory-sidebar">
    <div class="observatory-intro">
      <p class="eyebrow" data-i18n-en="Living Atlas" data-i18n-zh="全球图谱">Living Atlas</p>
      <h2
        data-i18n-en="Re-Inhabitability Atlas"
        data-i18n-zh="灾后再栖居图谱"
      >
        Re-Inhabitability Atlas
      </h2>
      <p
        data-i18n-en="A slowly turning globe of people, hazards, and places under pressure."
        data-i18n-zh="一个缓慢转动的地球，呈现人口、灾害与承压之地。"
      >
        A slowly turning globe of people, hazards, and places under pressure.
      </p>
    </div>

    <div class="atlas-actions" aria-label="Map controls">
      <button
        class="atlas-button"
        type="button"
        id="language-toggle"
        data-lang="en"
        data-i18n-en="中文"
        data-i18n-zh="English"
      >
        中文
      </button>
      <button
        class="atlas-button"
        type="button"
        id="rotation-toggle"
        data-rotating="true"
        data-i18n-en="Pause"
        data-i18n-zh="暂停旋转"
      >
        Pause
      </button>
      <button
        class="atlas-button"
        type="button"
        id="case-focus"
        data-i18n-en="Next story"
        data-i18n-zh="下一个案例"
      >
        Next story
      </button>
      <button
        class="atlas-button"
        type="button"
        id="story-auto"
        data-playing="false"
        data-i18n-en="Auto story"
        data-i18n-zh="自动案例"
      >
        Auto story
      </button>
      <button
        class="atlas-button"
        type="button"
        id="sound-toggle"
        data-sound="false"
        data-i18n-en="Sound"
        data-i18n-zh="声音"
      >
        Sound
      </button>
    </div>

    <div class="layer-panel atlas-legend" aria-label="Map layers">
      <div class="panel-heading">
        <h3 data-i18n-en="Legend" data-i18n-zh="图例">Legend</h3>
        <span
          id="earthquake-count"
          data-i18n-prefix-en="Live"
          data-i18n-prefix-zh="实时"
        >Loading</span>
      </div>
      {
        observatoryLayers.map((layer) => (
          <label class="layer-toggle" style={`--layer-color:${layer.color}`}>
            <input
              type="checkbox"
              data-layer={layer.id}
              checked={layer.defaultVisible}
            />
            <span />
            <strong
              data-i18n-en={layerCopy[layer.id].en}
              data-i18n-zh={layerCopy[layer.id].zh}
            >
              {layerCopy[layer.id].en}
            </strong>
            <small
              data-i18n-en={layerCopy[layer.id].noteEn}
              data-i18n-zh={layerCopy[layer.id].noteZh}
            >
              {layerCopy[layer.id].noteEn}
            </small>
          </label>
        ))
      }
    </div>

    <div class="map-stat-grid">
      <div>
        <strong>{observatoryLayers.length}</strong>
        <span>active layer configs</span>
      </div>
      <div>
        <strong>6</strong>
        <span>public web services</span>
      </div>
      <div>
        <strong>{geePlan.project}</strong>
        <span>GEE pipeline</span>
      </div>
    </div>

    <div class="map-detail" id="map-detail">
      <p class="eyebrow">Selected Location</p>
      <h3>Click an earthquake or switch layers</h3>
      <p>
        The first version streams USGS events and overlays global raster services. GEE-derived
        flood, heat, drought, and recovery products should be published as web tiles next.
      </p>
    </div>

    <details class="data-notes">
      <summary data-i18n-en="Data notes" data-i18n-zh="数据说明">Data notes</summary>
      <p
        data-i18n-en="Public layers from OpenStreetMap, WorldPop, NASA, NOAA, USGS, and UNEP-linked services. Milky Way background texture by Solar System Scope, CC BY 4.0, based on NASA imagery."
        data-i18n-zh="图层来自 OpenStreetMap、WorldPop、NASA、NOAA、USGS 以及 UNEP 相关公开服务。银河背景纹理来自 Solar System Scope，CC BY 4.0，基于 NASA 影像。"
      >
        Public layers from OpenStreetMap, WorldPop, NASA, NOAA, USGS, and UNEP-linked services. Milky Way background texture by Solar System Scope, CC BY 4.0, based on NASA imagery.
      </p>
    </details>
  </aside>

  {
    fullscreen && (
      <div class="atlas-entry" id="atlas-entry" aria-label="Map introduction">
        <button
          class="atlas-entry-lang"
          type="button"
          id="welcome-language-toggle"
          data-i18n-en="中文"
          data-i18n-zh="English"
        >
          中文
        </button>
        <div class="atlas-entry-copy">
          <div class="atlas-entry-logo" aria-hidden="true">
            <span />
          </div>
          <p class="eyebrow" data-i18n-en="Qiushan Li's Lab" data-i18n-zh="黎秋杉实验室">
            Qiushan Li's Lab
          </p>
          <h1
            data-i18n-en="Re-Inhabitability Atlas"
            data-i18n-zh="灾后再栖居图谱"
          >
            Re-Inhabitability Atlas
          </h1>
          <p
            class="atlas-entry-subtitle"
            data-i18n-en="A living globe of mountain villages, coastal memories, fragile homes, and the long work of returning to life after disaster."
            data-i18n-zh="一个关于山地村落、海岸记忆、脆弱住房，以及灾后重新回到生活的动态地球。"
          >
            A living globe of mountain villages, coastal memories, fragile homes, and the long work of returning to life after disaster.
          </p>
          <p
            class="atlas-entry-statement"
            data-i18n-en="Can a place become home again? Not as a dot on a map, but as a landscape people repair, remember, and return to."
            data-i18n-zh="一个地方能重新成为家吗？不是地图上的一个点，而是人们修复、记忆并重新返回的生活景观。"
          >
            Can a place become home again? Not as a dot on a map, but as a landscape people repair, remember, and return to.
          </p>
          <button
            class="atlas-enter-button"
            type="button"
            id="atlas-enter"
            data-i18n-en="Enter ↗"
            data-i18n-zh="进入 ↗"
          >
            Enter ↗
          </button>
          <span
            data-i18n-en="Sound and motion begin after entry"
            data-i18n-zh="进入后开启声音与案例播放"
          >
            Sound and motion begin after entry
          </span>
          <em data-i18n-en="Initializing atmosphere..." data-i18n-zh="正在初始化氛围...">
            Initializing atmosphere...
          </em>
        </div>
      </div>
    )
  }

  <div class="observatory-stage">
    <div id="global-disaster-map" class="global-disaster-map" />
  </div>

  <audio
    id="atlas-background-audio"
    src={assetUrl('/assets/videoplayback.mp4')}
    preload="auto"
    loop
  />
</section>

<script>
  import maplibregl from 'maplibre-gl';
  import { observatoryLayers } from '../data/disasterProjects';

  const mapContainer = document.getElementById('global-disaster-map');
  const detail = document.getElementById('map-detail');
  const earthquakeCount = document.getElementById('earthquake-count');
  const languageToggle = document.getElementById('language-toggle');
  const rotationToggle = document.getElementById('rotation-toggle');
  const caseFocus = document.getElementById('case-focus');
  const storyAuto = document.getElementById('story-auto');
  const soundToggle = document.getElementById('sound-toggle');
  const atlasEntry = document.getElementById('atlas-entry');
  const atlasEnter = document.getElementById('atlas-enter');
  const welcomeLanguageToggle = document.getElementById('welcome-language-toggle');
  const backgroundAudio = document.getElementById('atlas-background-audio');
  const toggles = Array.from(document.querySelectorAll('[data-layer]'));

  const today = new Date().toISOString().slice(0, 10);
  let language = 'en';
  let map = null;
  let isRotating = true;
  let isUserInteracting = false;
  let isStoryPlaying = false;
  let resumeTimer = null;
  let storyTimer = null;
  let lastFrame = 0;
  let activeCaseIndex = 0;
  let activePopup = null;
  let storyFlightTimer = null;
  let storyMarker = null;
  let soundEnabled = false;
  let audioContext = null;
  let atmosphereNodes = null;

  const caseFeatures = {
    type: 'FeatureCollection',
    features: [
      {
        type: 'Feature',
        geometry: { type: 'Point', coordinates: [103.4, 31.0] },
        properties: {
          layerId: 'earthquakes',
          titleEn: 'Wenchuan Earthquake',
          titleZh: '汶川地震',
          placeEn: 'Sichuan, China',
          placeZh: '中国四川',
          year: 2008,
          noteEn: 'A reconstruction case about housing, memory, landscape repair, and long-term re-inhabitation.',
          noteZh: '关于住房重建、记忆、山地景观修复与长期再栖居的关键案例。',
          whyEn: 'The earthquake transformed mountain settlements, schools, roads, ecological slopes, and everyday ideas of safety. It is a representative case for asking when rebuilt housing becomes livable home again.',
          whyZh: '这场地震改变了山地聚落、学校、道路、生态边坡和人们对安全的日常理解。它很适合用来讨论：房子重建之后，什么时候才真正重新成为可以生活的家？',
          questionsEn: 'Housing delivery · memory and mourning · relocation · landscape repair',
          questionsZh: '住房交付 · 记忆与哀悼 · 迁居 · 山地景观修复'
        }
      },
      {
        type: 'Feature',
        geometry: { type: 'Point', coordinates: [84.7, 28.15] },
        properties: {
          layerId: 'earthquakes',
          titleEn: 'Gorkha Earthquake',
          titleZh: '尼泊尔廓尔喀地震',
          placeEn: 'Central Nepal Himalaya',
          placeZh: '尼泊尔中部喜马拉雅山区',
          year: 2015,
          noteEn: 'A mountain reconstruction case about villages, heritage towns, slope hazards, and access to remote settlements.',
          noteZh: '关于山地村落、历史城镇、边坡灾害与偏远聚落可达性的重建案例。',
          whyEn: 'The Gorkha earthquake makes the Himalayan problem visible: rebuilding is shaped by altitude, roads, landslides, monsoon seasons, masonry traditions, and family labor migration.',
          whyZh: '廓尔喀地震清楚呈现了喜马拉雅问题：重建不只是在原地盖房，还受到海拔、道路、滑坡、季风、砌体传统和家庭外出务工的共同影响。',
          questionsEn: 'Mountain villages · heritage repair · landslide risk · remote access',
          questionsZh: '山地村落 · 遗产修复 · 滑坡风险 · 偏远可达性'
        }
      },
      {
        type: 'Feature',
        geometry: { type: 'Point', coordinates: [73.59, 34.49] },
        properties: {
          layerId: 'earthquakes',
          titleEn: 'Kashmir Earthquake',
          titleZh: '克什米尔地震',
          placeEn: 'Kashmir Himalaya',
          placeZh: '克什米尔喜马拉雅山区',
          year: 2005,
          noteEn: 'A cross-border mountain disaster where damaged roads, winter exposure, and dispersed settlements shaped recovery.',
          noteZh: '一次跨边界山地灾害，道路损毁、冬季暴露与分散聚落共同塑造了恢复过程。',
          whyEn: 'Kashmir shows how mountain earthquakes quickly become infrastructure disasters: blocked valleys, isolated villages, cold weather shelter, and uneven aid access define re-inhabitability.',
          whyZh: '克什米尔说明山地地震很快会变成基础设施灾害：山谷受阻、村庄孤立、寒冷季节安置和援助可达性不均，都会决定能否重新居住。',
          questionsEn: 'Road rupture · winter shelter · dispersed villages · aid access',
          questionsZh: '道路中断 · 冬季安置 · 分散村落 · 援助可达性'
        }
      },
      {
        type: 'Feature',
        geometry: { type: 'Point', coordinates: [88.15, 27.72] },
        properties: {
          layerId: 'earthquakes',
          titleEn: 'Sikkim Himalayan Earthquake',
          titleZh: '锡金喜马拉雅地震',
          placeEn: 'Sikkim and eastern Himalaya',
          placeZh: '锡金及喜马拉雅东段',
          year: 2011,
          noteEn: 'A high-relief earthquake case linking slope failure, hydropower corridors, fragile roads, and borderland communities.',
          noteZh: '连接边坡失稳、水电走廊、脆弱道路与边境社区的高山峡谷地震案例。',
          whyEn: 'In the eastern Himalaya, earthquake recovery is inseparable from landslide-prone roads and infrastructure corridors that decide whether people, medicine, and materials can move.',
          whyZh: '在喜马拉雅东段，地震恢复离不开易滑坡道路和基础设施走廊；它们决定人员、药品和建材能不能进入受灾地。',
          questionsEn: 'Slope failure · hydropower corridors · borderland access · repair sequencing',
          questionsZh: '边坡失稳 · 水电走廊 · 边境可达性 · 修复顺序'
        }
      },
      {
        type: 'Feature',
        geometry: { type: 'Point', coordinates: [82.19, 28.88] },
        properties: {
          layerId: 'earthquakes',
          titleEn: 'Jajarkot Earthquake',
          titleZh: '尼泊尔贾贾科特地震',
          placeEn: 'Western Nepal mountains',
          placeZh: '尼泊尔西部山区',
          year: 2023,
          noteEn: 'A recent mountain housing case where smaller magnitude still produced severe rural loss because vulnerability was concentrated in fragile homes.',
          noteZh: '一个近期山地住房案例：震级并非全球最大，但脆弱住房集中，使农村损失十分严重。',
          whyEn: 'Jajarkot is useful for the atlas because it shifts attention from spectacular magnitude to everyday vulnerability: stone houses, remoteness, cold nights, and slow reconstruction capacity.',
          whyZh: '贾贾科特适合放进图谱，因为它把注意力从“震级有多大”转向日常脆弱性：石砌住房、偏远区位、寒冷夜晚和有限的重建能力。',
          questionsEn: 'Rural housing fragility · cold exposure · remoteness · incremental rebuilding',
          questionsZh: '农村住房脆弱性 · 寒冷暴露 · 偏远性 · 渐进式重建'
        }
      },
      {
        type: 'Feature',
        geometry: { type: 'Point', coordinates: [102.08, 29.59] },
        properties: {
          layerId: 'earthquakes',
          titleEn: 'Luding Earthquake',
          titleZh: '泸定地震',
          placeEn: 'Eastern Tibetan Plateau, China',
          placeZh: '中国青藏高原东缘',
          year: 2022,
          noteEn: 'A steep-valley earthquake case about mountain roads, river corridors, slope instability, and settlement safety.',
          noteZh: '关于山地道路、河谷走廊、边坡不稳定与聚落安全的陡峻河谷地震案例。',
          whyEn: 'Luding extends the Himalayan arc eastward into the mountain edge of the Tibetan Plateau, where recovery depends on keeping river valleys, bridges, and slope settlements connected.',
          whyZh: '泸定把环喜马拉雅视野延伸到青藏高原东缘；这里的恢复取决于河谷、桥梁和山坡聚落能否保持连接。',
          questionsEn: 'Valley corridors · bridge access · slope settlements · ecological repair',
          questionsZh: '河谷走廊 · 桥梁通达 · 山坡聚落 · 生态修复'
        }
      },
      {
        type: 'Feature',
        geometry: { type: 'Point', coordinates: [140.9, 38.3] },
        properties: {
          layerId: 'tsunami-events',
          titleEn: 'Great East Japan Earthquake and Tsunami',
          titleZh: '东日本大地震与海啸',
          placeEn: 'Tohoku, Japan',
          placeZh: '日本东北',
          year: 2011,
          noteEn: 'A coastal recovery case linking tsunami risk, relocation, infrastructure, and cultural memory.',
          noteZh: '连接海啸风险、迁居、基础设施与地方记忆的沿海恢复案例。',
          whyEn: 'Recovery here is not only about seawalls or new towns; it is also about how coastal communities remember loss while deciding where and how to live with the sea.',
          whyZh: '这里的恢复不只是海堤或新城建设，也关乎沿海社区如何记住失去，并重新决定如何与海共同生活。',
          questionsEn: 'Coastal defense · relocation · memory landscapes · livelihood recovery',
          questionsZh: '海岸防护 · 迁居 · 记忆景观 · 生计恢复'
        }
      },
      {
        type: 'Feature',
        geometry: { type: 'Point', coordinates: [-72.3, 18.5] },
        properties: {
          layerId: 'earthquakes',
          titleEn: 'Haiti Earthquake',
          titleZh: '海地地震',
          placeEn: 'Port-au-Prince, Haiti',
          placeZh: '海地太子港',
          year: 2010,
          noteEn: 'A prolonged recovery case about displacement, aid governance, housing precarity, and social vulnerability.',
          noteZh: '关于长期流离、援助治理、住房不稳定与社会脆弱性的灾后恢复案例。',
          whyEn: 'Haiti shows that reconstruction can remain unfinished for years when housing, governance, land tenure, and social vulnerability are not repaired together.',
          whyZh: '海地说明，如果住房、治理、土地权属和社会脆弱性没有一起修复，重建可能多年都无法真正完成。',
          questionsEn: 'Displacement · aid governance · land tenure · housing precarity',
          questionsZh: '流离失所 · 援助治理 · 土地权属 · 住房不稳定'
        }
      },
      {
        type: 'Feature',
        geometry: { type: 'Point', coordinates: [95.85, 3.3] },
        properties: {
          layerId: 'tsunami-events',
          titleEn: 'Indian Ocean Tsunami',
          titleZh: '印度洋海啸',
          placeEn: 'Aceh and Indian Ocean coastlines',
          placeZh: '亚齐及印度洋沿岸',
          year: 2004,
          noteEn: 'A regional catastrophe that reshaped coastal planning, humanitarian response, and long-term relocation debates.',
          noteZh: '重塑沿海规划、人道响应与长期迁居讨论的区域性灾难。',
          whyEn: 'The event connected distant coastlines through one disaster, making recovery a regional question of warning, rebuilding, livelihood, and coastal attachment.',
          whyZh: '这场灾难把相隔很远的海岸线连接在一起，使恢复成为关于预警、重建、生计和海岸依附的区域性问题。',
          questionsEn: 'Warning systems · coastal rebuilding · fisheries · relocation ethics',
          questionsZh: '预警系统 · 沿海重建 · 渔业生计 · 迁居伦理'
        }
      },
      {
        type: 'Feature',
        geometry: { type: 'Point', coordinates: [125.0, 11.2] },
        properties: {
          layerId: 'hurricane-tracks',
          titleEn: 'Typhoon Haiyan',
          titleZh: '台风海燕',
          placeEn: 'Eastern Visayas, Philippines',
          placeZh: '菲律宾东维萨亚',
          year: 2013,
          noteEn: 'A storm recovery case about shelter, livelihood, coastal risk, and uneven rebuilding.',
          noteZh: '关于安置、生计、沿海风险与不均衡重建的风暴恢复案例。',
          whyEn: 'Haiyan makes visible the distance between emergency shelter and durable dwelling, especially for coastal families whose livelihood depends on proximity to the sea.',
          whyZh: '海燕让人看到紧急安置与真正可持续居住之间的距离，尤其是那些生计依赖近海空间的家庭。',
          questionsEn: 'Shelter to dwelling · coastal livelihoods · risk zoning · uneven rebuilding',
          questionsZh: '从安置到居住 · 沿海生计 · 风险分区 · 不均衡重建'
        }
      }
    ]
  };

  const arcgisImageTile = (layer) => {
    const params = [
      'bbox={bbox-epsg-3857}',
      'bboxSR=3857',
      'imageSR=3857',
      'size=256,256',
      'format=png32',
      'transparent=true',
      'f=image'
    ];
    if (layer.renderingRule) {
      params.push(`renderingRule=${encodeURIComponent(JSON.stringify(layer.renderingRule))}`);
    }

    return `${layer.source}?${params.join('&')}`;
  };

  const layerMeta = Object.fromEntries(observatoryLayers.map((layer) => [layer.id, layer]));

  const applyLanguage = (nextLanguage) => {
    language = nextLanguage;
    document.documentElement.lang = language === 'zh' ? 'zh-CN' : 'en';
    document.querySelectorAll('[data-i18n-en]').forEach((element) => {
      element.textContent = element.dataset[`i18n${language === 'zh' ? 'Zh' : 'En'}`];
    });

    if (earthquakeCount.dataset.count) {
      earthquakeCount.textContent =
        language === 'zh'
          ? `实时 ${earthquakeCount.dataset.count} 次`
          : `Live ${earthquakeCount.dataset.count}`;
    }

    storyAuto.textContent =
      language === 'zh'
        ? isStoryPlaying ? '暂停案例' : '自动案例'
        : isStoryPlaying ? 'Pause story' : 'Auto story';
    updateSoundLabel();
  };

  const updateSoundLabel = () => {
    if (!soundToggle) return;
    soundToggle.textContent =
      language === 'zh'
        ? soundEnabled ? '静音' : '声音'
        : soundEnabled ? 'Mute' : 'Sound';
    soundToggle.dataset.sound = String(soundEnabled);
    soundToggle.classList.toggle('is-active', soundEnabled);
  };

  const setDetail = (html) => {
    detail.innerHTML = html;
  };

  const pauseRotationTemporarily = () => {
    isUserInteracting = true;
    window.clearTimeout(resumeTimer);
    resumeTimer = window.setTimeout(() => {
      isUserInteracting = false;
    }, 5000);
  };

  const rotateGlobe = (time) => {
    if (map && isRotating && !isUserInteracting && !isStoryPlaying) {
      const delta = lastFrame ? time - lastFrame : 16;
      const center = map.getCenter();
      map.setCenter([center.lng + delta * 0.0018, center.lat]);
    }
    lastFrame = time;
    window.requestAnimationFrame(rotateGlobe);
  };

  const toggleLayer = (map, id, visible) => {
    const visibility = visible ? 'visible' : 'none';
    if (map.getLayer(id)) {
      map.setLayoutProperty(id, 'visibility', visibility);
    }
  };

  const setToggleState = (id, visible) => {
    const input = document.querySelector(`[data-layer="${id}"]`);
    if (input) {
      input.checked = visible;
    }
  };

  const showOnlyStoryLayer = (layerId) => {
    observatoryLayers.forEach((layer) => {
      const visible = layer.id === layerId;
      toggleLayer(map, layer.id, visible);
      setToggleState(layer.id, visible);
    });

    if (map.getLayer('featured-cases')) {
      map.setLayoutProperty('featured-cases', 'visibility', 'visible');
    }
  };

  const setActiveStoryHeatmap = (feature) => {
    const source = map?.getSource('featured-cases');
    if (source) {
      source.setData({
        type: 'FeatureCollection',
        features: [feature]
      });
    }
  };

  const closeActivePopup = () => {
    if (activePopup) {
      activePopup.remove();
      activePopup = null;
    }
  };

  const moveStoryMarker = (coordinates) => {
    if (!storyMarker) {
      const markerElement = document.createElement('div');
      markerElement.className = 'story-ripple-marker';
      markerElement.innerHTML = '<span></span>';
      storyMarker = new maplibregl.Marker({ element: markerElement, anchor: 'center' })
        .setLngLat(coordinates)
        .addTo(map);
    } else {
      storyMarker.setLngLat(coordinates);
    }
  };

  const getAudioContext = () => {
    const AudioCtor = window.AudioContext || window.webkitAudioContext;
    if (!AudioCtor) return null;
    if (!audioContext) {
      audioContext = new AudioCtor();
    }
    return audioContext;
  };

  const startAtmosphere = () => {
    const context = getAudioContext();
    if (!context || atmosphereNodes) return;

    const now = context.currentTime;
    const master = context.createGain();
    const filter = context.createBiquadFilter();
    const droneLow = context.createOscillator();
    const droneMid = context.createOscillator();
    const shimmer = context.createOscillator();
    const shimmerGain = context.createGain();
    const noise = context.createBufferSource();
    const noiseFilter = context.createBiquadFilter();
    const noiseGain = context.createGain();

    master.gain.setValueAtTime(0.0001, now);
    master.gain.exponentialRampToValueAtTime(0.085, now + 2.4);
    filter.type = 'lowpass';
    filter.frequency.setValueAtTime(420, now);
    filter.Q.setValueAtTime(0.8, now);

    droneLow.type = 'sine';
    droneLow.frequency.setValueAtTime(41, now);
    droneMid.type = 'triangle';
    droneMid.frequency.setValueAtTime(55, now);
    shimmer.type = 'sine';
    shimmer.frequency.setValueAtTime(166, now);
    shimmerGain.gain.setValueAtTime(0.012, now);

    const bufferSize = context.sampleRate * 3;
    const noiseBuffer = context.createBuffer(1, bufferSize, context.sampleRate);
    const channel = noiseBuffer.getChannelData(0);
    for (let i = 0; i < bufferSize; i += 1) {
      const fade = 0.65 + Math.sin((i / bufferSize) * Math.PI * 2) * 0.22;
      channel[i] = (Math.random() * 2 - 1) * fade;
    }
    noise.buffer = noiseBuffer;
    noise.loop = true;
    noiseFilter.type = 'bandpass';
    noiseFilter.frequency.setValueAtTime(190, now);
    noiseFilter.Q.setValueAtTime(0.7, now);
    noiseGain.gain.setValueAtTime(0.018, now);

    droneLow.connect(filter);
    droneMid.connect(filter);
    shimmer.connect(shimmerGain);
    shimmerGain.connect(filter);
    noise.connect(noiseFilter);
    noiseFilter.connect(noiseGain);
    noiseGain.connect(filter);
    filter.connect(master);
    master.connect(context.destination);

    droneLow.start(now);
    droneMid.start(now);
    shimmer.start(now);
    noise.start(now);

    atmosphereNodes = {
      master,
      sources: [droneLow, droneMid, shimmer, noise]
    };
  };

  const stopAtmosphere = () => {
    if (!atmosphereNodes || !audioContext) return;
    const now = audioContext.currentTime;
    atmosphereNodes.master.gain.cancelScheduledValues(now);
    atmosphereNodes.master.gain.setTargetAtTime(0.0001, now, 0.6);
    window.setTimeout(() => {
      atmosphereNodes?.sources.forEach((source) => {
        try {
          source.stop();
        } catch {}
      });
      atmosphereNodes?.master.disconnect();
      atmosphereNodes = null;
    }, 1200);
  };

  const startBackgroundAudio = async () => {
    if (!backgroundAudio) return false;
    backgroundAudio.volume = 0.38;
    backgroundAudio.loop = true;
    try {
      await backgroundAudio.play();
      stopAtmosphere();
      return true;
    } catch {
      return false;
    }
  };

  const stopBackgroundAudio = () => {
    if (!backgroundAudio) return;
    backgroundAudio.pause();
    backgroundAudio.currentTime = 0;
  };

  const toggleSound = async () => {
    const context = getAudioContext();
    if (!context) return;
    if (context.state === 'suspended') {
      await context.resume();
    }
    soundEnabled = !soundEnabled;
    updateSoundLabel();
    if (soundEnabled) {
      const isBackgroundPlaying = await startBackgroundAudio();
      if (!isBackgroundPlaying) {
        startAtmosphere();
      }
    } else {
      stopBackgroundAudio();
      stopAtmosphere();
    }
  };

  const enterAtlas = async () => {
    atlasEntry?.classList.add('is-hidden');
    if (!soundEnabled) {
      await toggleSound();
    }
    setStoryPlaying(true);
  };

  const setStoryPlaying = (playing) => {
    isStoryPlaying = playing;
    storyAuto.dataset.playing = String(playing);
    storyAuto.textContent =
      language === 'zh'
        ? playing ? '暂停案例' : '自动案例'
        : playing ? 'Pause story' : 'Auto story';
    window.clearInterval(storyTimer);
    if (playing) {
      flyToCase(activeCaseIndex);
      storyTimer = window.setInterval(() => {
        flyToCase(activeCaseIndex);
      }, 8200);
    }
  };

  const casePopupHtml = (properties) => `
    <div class="case-popup">
      <span>${properties.year}</span>
      <strong>${language === 'zh' ? properties.titleZh : properties.titleEn}</strong>
      <em>${language === 'zh' ? properties.placeZh : properties.placeEn}</em>
      <p>${language === 'zh' ? properties.noteZh : properties.noteEn}</p>
      <p>${language === 'zh' ? properties.whyZh : properties.whyEn}</p>
      <small>${language === 'zh' ? properties.questionsZh : properties.questionsEn}</small>
    </div>
  `;

  const flyToCase = (index) => {
    if (!map) return;
    const feature = caseFeatures.features[index % caseFeatures.features.length];
    activeCaseIndex = (index + 1) % caseFeatures.features.length;
    pauseRotationTemporarily();
    closeActivePopup();
    showOnlyStoryLayer(feature.properties.layerId);
    setActiveStoryHeatmap(feature);
    const coordinates = feature.geometry.coordinates;
    moveStoryMarker(coordinates);
    window.clearTimeout(storyFlightTimer);
    map.flyTo({
      center: [coordinates[0] * 0.35, Math.max(Math.min(coordinates[1] * 0.35, 28), -28)],
      zoom: 1.65,
      speed: 0.72,
      curve: 1.35,
      essential: true
    });
    storyFlightTimer = window.setTimeout(() => {
      map.flyTo({
        center: coordinates,
        zoom: 5.05,
        speed: 0.82,
        curve: 1.18,
        essential: true
      });
      window.setTimeout(() => {
        closeActivePopup();
        activePopup = new maplibregl.Popup({ offset: 18, className: 'atlas-popup', closeButton: false })
          .setLngLat(coordinates)
          .setHTML(casePopupHtml(feature.properties))
          .addTo(map);
      }, 1600);
    }, 1400);
  };

  const addGibsLayer = (map, layer) => {
    map.addSource(layer.id, {
      type: 'raster',
      tiles: [layer.source],
      tileSize: 256,
      attribution: ''
    });

    map.addLayer({
      id: layer.id,
      type: 'raster',
      source: layer.id,
      layout: { visibility: layer.defaultVisible ? 'visible' : 'none' },
      paint: { 'raster-opacity': 0.84 }
    });
  };

  const addCaseLayer = (map) => {
    map.addSource('featured-cases', {
      type: 'geojson',
      data: {
        type: 'FeatureCollection',
        features: []
      }
    });

    map.addLayer({
      id: 'featured-cases',
      type: 'heatmap',
      source: 'featured-cases',
      layout: { visibility: 'none' },
      paint: {
        'heatmap-weight': 1,
        'heatmap-intensity': ['interpolate', ['linear'], ['zoom'], 1, 0.55, 5, 1.28],
        'heatmap-color': [
          'interpolate',
          ['linear'],
          ['heatmap-density'],
          0,
          'rgba(217, 180, 109, 0)',
          0.35,
          'rgba(217, 180, 109, 0.18)',
          0.68,
          'rgba(197, 111, 88, 0.4)',
          0.9,
          'rgba(199, 111, 126, 0.62)'
        ],
        'heatmap-radius': ['interpolate', ['linear'], ['zoom'], 1, 10, 5, 28],
        'heatmap-opacity': 0.84
      }
    });
  };

  const addRasterLayer = (map, layer) => {
    if (layer.id === 'active-fire') {
      map.addSource(layer.id, {
        type: 'raster',
        tiles: [
          `https://gibs.earthdata.nasa.gov/wmts/epsg3857/best/VIIRS_SNPP_Thermal_Anomalies_375m_All/default/${today}/GoogleMapsCompatible_Level8/{z}/{y}/{x}.png`
        ],
        tileSize: 256,
        attribution: ''
      });
    } else {
      map.addSource(layer.id, {
        type: 'raster',
        tiles: [arcgisImageTile(layer)],
        tileSize: 256,
        attribution: ''
      });
    }

    map.addLayer({
      id: layer.id,
      type: 'raster',
      source: layer.id,
      layout: { visibility: layer.defaultVisible ? 'visible' : 'none' },
      paint: { 'raster-opacity': layer.id === 'population' ? 0.9 : 0.8 }
    });
  };

  const addRemoteGeojsonLayer = async (map, layer) => {
    const response = await fetch(layer.source);
    if (!response.ok) throw new Error(`${layer.id} unavailable`);
    const geojson = await response.json();

    map.addSource(layer.id, {
      type: 'geojson',
      data: geojson
    });

    if (layer.type === 'geojson-line') {
      map.addLayer({
        id: layer.id,
        type: 'line',
        source: layer.id,
        layout: { visibility: layer.defaultVisible ? 'visible' : 'none' },
        paint: {
          'line-color': [
            'interpolate',
            ['linear'],
            ['coalesce', ['get', 'USA_WIND'], 64],
            64,
            '#d7c9e8',
            96,
            '#b59ad6',
            137,
            '#8f6fbd'
          ],
          'line-width': [
            'interpolate',
            ['linear'],
            ['coalesce', ['get', 'USA_WIND'], 64],
            64,
            1.2,
            96,
            2.2,
            137,
            3.4
          ],
          'line-opacity': 0.94
        }
      });

      map.on('click', layer.id, (event) => {
        const feature = event.features?.[0];
        if (!feature) return;
        const props = feature.properties;
        setDetail(`
          <p class="eyebrow">Hurricane track</p>
          <h3>${props.NAME ?? 'Tropical cyclone'} (${props.year ?? 'year unknown'})</h3>
          <p><strong>${props.USA_WIND ?? 'n/a'} kt</strong> · ${props.BASIN ?? 'basin unknown'}</p>
          <p>Track intensity can be compared against population exposure, flood risk, and recovery capacity layers.</p>
        `);
      });
    } else {
      map.addLayer({
        id: layer.id,
        type: 'heatmap',
        source: layer.id,
        layout: { visibility: layer.defaultVisible ? 'visible' : 'none' },
        paint: {
          'heatmap-weight': [
            'interpolate',
            ['linear'],
            ['coalesce', ['get', 'DEATHS'], 0],
            0,
            0.35,
            100,
            0.75,
            1000,
            1.25
          ],
          'heatmap-intensity': ['interpolate', ['linear'], ['zoom'], 1, 0.55, 5, 1.45],
          'heatmap-color': [
            'interpolate',
            ['linear'],
            ['heatmap-density'],
          0,
          'rgba(119, 199, 184, 0)',
          0.3,
          'rgba(185, 226, 217, 0.28)',
          0.62,
          'rgba(119, 199, 184, 0.52)',
          0.9,
          'rgba(58, 156, 142, 0.8)'
        ],
        'heatmap-radius': ['interpolate', ['linear'], ['zoom'], 1, 10, 5, 30],
        'heatmap-opacity': 0.86
        }
      });
    }
  };

  const loadEarthquakes = async (map) => {
    const layer = layerMeta.earthquakes;
    const response = await fetch(layer.source);
    if (!response.ok) {
      throw new Error('USGS feed unavailable');
    }

    const geojson = await response.json();
    earthquakeCount.dataset.count = `${geojson.features.length}`;
    earthquakeCount.textContent =
      language === 'zh' ? `实时 ${geojson.features.length} 次` : `Live ${geojson.features.length}`;

    map.addSource('earthquakes', {
      type: 'geojson',
      data: geojson
    });

    map.addLayer({
      id: 'earthquakes',
      type: 'heatmap',
      source: 'earthquakes',
      layout: { visibility: layer.defaultVisible ? 'visible' : 'none' },
      paint: {
        'heatmap-weight': [
          'interpolate',
          ['linear'],
          ['coalesce', ['get', 'mag'], 2.5],
          2.5,
          0.25,
          5,
          0.75,
          7,
          1.5
        ],
        'heatmap-intensity': ['interpolate', ['linear'], ['zoom'], 1, 0.55, 5, 1.5],
        'heatmap-color': [
          'interpolate',
          ['linear'],
          ['heatmap-density'],
          0,
          'rgba(141, 183, 210, 0)',
          0.28,
          'rgba(141, 183, 210, 0.34)',
          0.6,
          'rgba(217, 180, 109, 0.56)',
          0.9,
          'rgba(199, 111, 126, 0.82)'
        ],
        'heatmap-radius': ['interpolate', ['linear'], ['zoom'], 1, 10, 5, 30],
        'heatmap-opacity': 0.88
      }
    });
  };

  const makeFallback = () => {
    mapContainer.classList.add('is-observatory-fallback');
    mapContainer.innerHTML = `
      <div class="fallback-surface population"></div>
      <div class="fallback-surface flood"></div>
      <div class="fallback-surface fire"></div>
      <div class="fallback-note">
        <strong>Map engine fallback</strong>
        <span>WebGL is unavailable. The public data services are configured, but interactive MapLibre rendering needs browser WebGL.</span>
      </div>
    `;
    earthquakeCount.textContent = language === 'zh' ? '图层已配置' : 'Layers ready';
  };

  try {
    map = new maplibregl.Map({
      container: mapContainer,
      style: {
        version: 8,
        sources: {
          basemap: {
            type: 'raster',
            tiles: [
              'https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}'
            ],
            tileSize: 256,
            attribution: ''
          }
        },
        layers: [
          {
            id: 'basemap',
            type: 'raster',
            source: 'basemap',
            paint: {
              'raster-opacity': 0.78,
              'raster-saturation': -0.72,
              'raster-contrast': 0.08,
              'raster-brightness-min': 0,
              'raster-brightness-max': 0.78
            }
          }
        ]
      },
      center: [22, 12],
      zoom: 1.72,
      minZoom: 1,
      maxZoom: 8,
      cooperativeGestures: true,
      attributionControl: false
    });

    map.addControl(new maplibregl.AttributionControl({ customAttribution: 'Sources' }), 'bottom-right');

    map.on('style.load', () => {
      try {
        map.setProjection({ type: 'globe' });
      } catch {
        // Keep the atlas usable if a browser cannot switch to globe projection.
      }
    });

    ['dragstart', 'zoomstart', 'rotatestart', 'pitchstart', 'mousedown', 'touchstart', 'wheel'].forEach((eventName) => {
      map.on(eventName, pauseRotationTemporarily);
    });

    let initialized = false;
    const initializeLayers = async () => {
      if (initialized) return;
      if (!map.isStyleLoaded()) {
        window.setTimeout(initializeLayers, 250);
        return;
      }
      initialized = true;

      observatoryLayers
        .filter((layer) => layer.type === 'raster')
        .forEach((layer) => addRasterLayer(map, layer));

      observatoryLayers
        .filter((layer) => layer.type === 'gibs-raster')
        .forEach((layer) => addGibsLayer(map, layer));

      try {
        await loadEarthquakes(map);
      } catch {
        earthquakeCount.textContent = language === 'zh' ? '地震暂不可用' : 'Earthquakes unavailable';
      }

      await Promise.allSettled(
        observatoryLayers
          .filter((layer) => layer.type === 'geojson-line' || layer.type === 'geojson-point')
          .map((layer) => addRemoteGeojsonLayer(map, layer))
      );
      addCaseLayer(map);

      toggles.forEach((input) => {
        toggleLayer(map, input.dataset.layer, input.checked);
      });
    };

    map.once('load', initializeLayers);
    map.once('style.load', initializeLayers);
    window.setTimeout(initializeLayers, 1200);

    toggles.forEach((input) => {
      input.addEventListener('change', () => {
        pauseRotationTemporarily();
        const layer = layerMeta[input.dataset.layer];
        toggleLayer(map, input.dataset.layer, input.checked);
      });
    });

    languageToggle.addEventListener('click', () => {
      applyLanguage(language === 'zh' ? 'en' : 'zh');
    });

    welcomeLanguageToggle?.addEventListener('click', () => {
      applyLanguage(language === 'zh' ? 'en' : 'zh');
    });

    rotationToggle.addEventListener('click', () => {
      isRotating = !isRotating;
      rotationToggle.dataset.rotating = String(isRotating);
      rotationToggle.textContent =
        language === 'zh'
          ? isRotating ? '暂停旋转' : '继续旋转'
          : isRotating ? 'Pause' : 'Rotate';
    });

    caseFocus.addEventListener('click', () => {
      setStoryPlaying(false);
      flyToCase(activeCaseIndex);
    });

    storyAuto.addEventListener('click', () => {
      setStoryPlaying(!isStoryPlaying);
    });

    soundToggle.addEventListener('click', toggleSound);
    atlasEnter?.addEventListener('click', enterAtlas);

    window.requestAnimationFrame(rotateGlobe);
    applyLanguage('en');
  } catch {
    makeFallback();
  }
</script>
