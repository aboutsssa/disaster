---
interface Props {
  eyebrow?: string;
  eyebrowEn?: string;
  eyebrowZh?: string;
  title: string;
  titleEn?: string;
  titleZh?: string;
  text: string;
  textEn?: string;
  textZh?: string;
  image?: string;
  className?: string;
}

const {
  eyebrow,
  eyebrowEn = eyebrow,
  eyebrowZh = eyebrow,
  title,
  titleEn = title,
  titleZh = title,
  text,
  textEn = text,
  textZh = text,
  image,
  className
} = Astro.props;
---

<section class:list={['page-hero', image && 'has-image', className]}>
  <div class="page-hero-copy">
    {
      eyebrowZh && (
        <p class="eyebrow" data-lang-en={eyebrowEn} data-lang-zh={eyebrowZh}>
          {eyebrowZh}
        </p>
      )
    }
    <h1 data-lang-en={titleEn} data-lang-zh={titleZh}>{titleZh}</h1>
    <p data-lang-en={textEn} data-lang-zh={textZh}>{textZh}</p>
  </div>
  {image && <img src={image} alt="" loading="eager" />}
</section>
